    "b-readme-initialize-submodules-wi-16": {
      "id": "b-readme-initialize-submodules-wi-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Install Bun 1.4.2. Initialize submodules with "
        },
        {
          "insert": "git submodule update --init --recursive",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". macOS requires Apple Silicon and full Xcode with its Metal compiler for the MLX helper. The complete client and helper build uses Xcode 26+ and Swift 6.2+. If Metal is missing, run "
        },
        {
          "insert": "xcodebuild -downloadComponent MetalToolchain",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-readme-linux-requires-swift-6-2-17": {
      "id": "b-readme-linux-requires-swift-6-2-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Linux requires Bun, a C/C++ toolchain, CMake, Git, curl, pkg-config, and libcurl development headers. Swift is not required. CUDA builds also need a compatible NVIDIA driver and CUDA toolkit. The "
        },
        {
          "insert": "Dockerfile",
          "attributes": {
            "link": "Dockerfile"
          }
        },
        {
          "insert": " provides a pinned Ubuntu 24.04 build environment."
        }
      ],
      "children": []
    },
    "b-readme-sh-18": {
      "id": "b-readme-sh-18",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "./scripts/build-server.sh                      # macOS Metal/MLX; Linux CPU\nTRANSCRIBER_CUDA=ON ./scripts/build-server.sh  # Linux with CUDA"
        }
      ],
      "children": []
    },
    "b-readme-output-is-build-server-19": {
      "id": "b-readme-output-is-build-server-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "./scripts/build-server.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " writes "
        },
        {
          "insert": "build/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which holds the "
        },
        {
          "insert": "transcriber-server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " executable, native helpers, VAD, notices, and resources. Each build replaces the whole directory. Keep the package together, because the Mac proofreader requires the adjacent Metal library and bundles. Large model weights and user data live outside it."
        }
      ],
      "children": []
    },
    "b-readme-sotto-build-jobs-contr-20": {
      "id": "b-readme-sotto-build-jobs-contr-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "TRANSCRIBER_BUILD_JOBS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " controls build concurrency. For another CPU/GPU host, use "
        },
        {
          "insert": "TRANSCRIBER_NATIVE=OFF",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and set "
        },
        {
          "insert": "TRANSCRIBER_CUDA_ARCHITECTURES",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the destination GPU. CPU support is useful for portable builds. Validate CUDA support, memory, and dictation latency on the selected host."
        }
      ],
      "children": []
    },
    "b-readme-run-21": {
      "id": "b-readme-run-21",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Run"
        }
      ],
      "children": []
