    "b-readme-run-these-commands-from-4": {
      "id": "b-readme-run-these-commands-from-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run these commands from the repository root. Weights use about 4 GB of disk; runtime memory also includes model state and inference buffers. The server verifies pinned files before loading and keeps models warm. It does not download large weights automatically."
        }
      ],
      "children": []
    },
