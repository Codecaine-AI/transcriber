        "language": "sh"
      },
      "text": [
        {
          "insert": "mkdir -p .local/models\ncurl --fail --location --retry 3 \\\n  --output .local/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf \\\n  https://huggingface.co/unsloth/Qwen3-4B-Instruct-2507-GGUF/resolve/a06e946bb6b655725eafa393f4a9745d460374c9/Qwen3-4B-Instruct-2507-Q4_K_M.gguf"
        }
      ],
      "children": []
    },
    "b-readme-expected-size-2-497-281-14": {
      "id": "b-readme-expected-size-2-497-281-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Expected size: 2,497,281,120 bytes. SHA-256: "
        },
        {
          "insert": "3605803b982cb64aead44f6c1b2ae36e3acdb41d8e46c8a94c6533bc4c67e597",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The server verifies both before loading."
        }
      ],
      "children": []
    },
    "b-readme-build-15": {
      "id": "b-readme-build-15",
