    },
    "b-readme-the-mlx-directory-must-c-9": {
      "id": "b-readme-the-mlx-directory-must-c-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The MLX directory must contain exactly the six files listed below. Download the pinned revision:"
        }
      ],
      "children": []
    },
    "b-readme-sh-10": {
      "id": "b-readme-sh-10",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "(\n  set -e\n  transcriber_qwen_dir=\"$PWD/.local/models/Qwen3-4B-Instruct-2507-MLX-4bit\"\n  transcriber_qwen_url=\"https://huggingface.co/mlx-community/Qwen3-4B-Instruct-2507-4bit\"\n  transcriber_qwen_url=\"$transcriber_qwen_url/resolve/50d427756c6b1b2fe0c0a10f67fbda1fc8e82c1b\"\n  mkdir -p \"$transcriber_qwen_dir\"\n  for file in model.safetensors config.json tokenizer.json tokenizer_config.json generation_config.json chat_template.jinja; do\n    curl --fail --location --retry 3 --output \"$transcriber_qwen_dir/$file\" \"$transcriber_qwen_url/$file\"\n  done\n)"
        }
      ],
      "children": []
    },
    "b-readme-sources-sottocore-textm-11": {
      "id": "b-readme-sources-sottocore-textm-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sources/TranscriberCore/TextModel.swift",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defines the six-file size/hash manifest. The MLX helper verifies it before becoming ready. Use regular files, with no extra files or symlinks in the model directory."
        }
      ],
      "children": []
    },
