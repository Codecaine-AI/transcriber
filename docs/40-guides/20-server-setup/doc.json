    "b-readme-the-dev-runner-fixes-its-27": {
      "id": "b-readme-the-dev-runner-fixes-its-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The dev runner fixes its host to loopback and defaults to port 8391, "
        },
        {
          "insert": ".local/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for data, and "
        },
        {
          "insert": ".local/server.log",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for logs. Set "
        },
        {
          "insert": "TRANSCRIBER_SPEECH_MODEL",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "TRANSCRIBER_TEXT_MODEL",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when using the paths above. Without those overrides, macOS searches "
        },
        {
          "insert": "~/Library/Application Support/Transcriber/Models/ggml-large-v3-turbo.bin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "~/.transcriber/models/Qwen3-4B-Instruct-2507-MLX-4bit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "server-setup-launchd-service": {
      "id": "server-setup-launchd-service",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "On Ford's Mac, the launchd service "
        },
        {
          "insert": "ai.codecaine.sotto.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs "
        },
        {
          "insert": "scripts/run-server-local.sh",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/run-server-local.sh"
            }
          }
        },
        {
          "insert": ". Its plist has identical copies in "
        },
        {
          "insert": ".local",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "~/Library/LaunchAgents",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the label keeps the name Sotto. The script finds the executables in "
        },
        {
          "insert": "build/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " by role: the "
        },
        {
          "insert": "*-server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " file, the "
        },
        {
          "insert": "*-text-engine",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " helper, and the other "
        },
        {
          "insert": "*-engine",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " helper. If it does not find exactly one of each, it exits and asks for a rebuild."
        }
      ],
      "children": []
    },
    "server-setup-launcher-defaults": {
      "id": "server-setup-launcher-defaults",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The script starts the server on "
        },
        {
          "insert": "127.0.0.1:8391",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with data in "
        },
        {
          "insert": ".local/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It loads "
        },
        {
          "insert": ".local/models/ggml-large-v3-turbo.bin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": ".local/models/Qwen3-4B-Instruct-2507-MLX-4bit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "TRANSCRIBER_SPEECH_MODEL",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "TRANSCRIBER_TEXT_MODEL",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " override those paths. After a rebuild with "
        },
        {
          "insert": "./scripts/build-server.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", restart the service. The plist needs no edit."
        }
      ],
      "children": []
    },
    "b-readme-remote-access-28": {
      "id": "b-readme-remote-access-28",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Remote access"
        }
      ],
      "children": []
    },
    "b-readme-bind-to-a-reachable-addr-29": {
      "id": "b-readme-bind-to-a-reachable-addr-29",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Bind to a reachable address and pass "
        },
        {
          "insert": "--token-file /absolute/path/to/token",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Nonloopback listeners require a token of at least 32 characters with no internal whitespace. In the Mac app, enter the endpoint and token under "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": "; tokens are stored in Keychain."
        }
      ],
      "children": []
    },
    "b-readme-use-an-https-reverse-pro-30": {
      "id": "b-readme-use-an-https-reverse-pro-30",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use an HTTPS reverse proxy for hosted servers and hostnames, including Tailscale MagicDNS names. The runner itself serves HTTP."
        }
      ],
      "children": []
    },
    "b-readme-http-is-accepted-for-loc-31": {
      "id": "b-readme-http-is-accepted-for-loc-31",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "HTTP is accepted for localhost and literal Tailscale IPs in "
        },
        {
          "insert": "100.64.0.0/10",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "fd7a:115c:a1e0::/48",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on your connected tailnet. The client checks the address range, not routing; use HTTPS if that private route cannot be assured."
        }
      ],
      "children": []
    },
    "b-readme-ordinary-lan-ips-require-32": {
      "id": "b-readme-ordinary-lan-ips-require-32",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Ordinary LAN IPs require HTTPS. Endpoints cannot contain credentials, queries, or fragments. Credential-bearing redirects are not followed."
        }
      ],
      "children": []
    },
    "b-readme-keep-the-data-directory-33": {
      "id": "b-readme-keep-the-data-directory-33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keep the data directory on persistent storage and back it up. Only one runner can own it. See "
        },
        {
          "insert": "storage",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-architecture"
            }
          }
        },
        {
          "insert": " and the "
        },
        {
          "insert": "HTTP API",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-http-api"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-readme-containers-34": {
      "id": "b-readme-containers-34",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Containers"
        }
      ],
      "children": []
    },
    "b-readme-build-from-the-repositor-35": {
      "id": "b-readme-build-from-the-repositor-35",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Build from the repository root with initialized submodules:"
        }
      ],
      "children": []
    },
    "b-readme-sh-36": {
      "id": "b-readme-sh-36",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "docker build -f Server/Dockerfile --target cpu -t transcriber-server:cpu .\ndocker build -f Server/Dockerfile --target cuda -t transcriber-server:cuda ."
        }
      ],
      "children": []
    },
    "b-readme-cuda-architectures-c-37": {
      "id": "b-readme-cuda-architectures-c-37",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "CUDA_ARCHITECTURES",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "CUDA_IMAGE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "BUN_IMAGE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "UBUNTU_IMAGE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "BUILD_JOBS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are build arguments. Choose CUDA architectures/toolkit/driver versions for your GPU. GPU containers require NVIDIA Container Toolkit and "
        },
        {
          "insert": "--gpus all",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Linux containers on a Mac do not have Metal access."
        }
      ],
      "children": []
    },
    "b-readme-mount-a-directory-contai-38": {
      "id": "b-readme-mount-a-directory-contai-38",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Mount a directory containing the Whisper "
        },
        {
          "insert": ".bin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and Qwen "
        },
        {
          "insert": ".gguf",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " files, plus a token file:"
        }
      ],
      "children": []
    },
    "b-readme-sh-39": {
      "id": "b-readme-sh-39",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "docker run --rm --name transcriber-server \\\n  -p 127.0.0.1:8391:8391 \\\n  --mount type=volume,source=transcriber-data,target=/data \\\n  --mount type=bind,source=/absolute/path/to/models,target=/models,readonly \\\n  --mount type=bind,source=/absolute/path/to/token,target=/run/secrets/transcriber-token,readonly \\\n  transcriber-server:cpu"
        }
      ],
      "children": []
    },
    "b-readme-for-a-gpu-server-use-s-40": {
      "id": "b-readme-for-a-gpu-server-use-s-40",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For a GPU server, use "
        },
        {
          "insert": "transcriber-server:cuda",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and add "
        },
        {
          "insert": "--gpus all",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The example exposes only host loopback; use the remote-access setup above for clients on other machines. The container runs as UID 10001, which must be able to read model/token files and write "
        },
        {
          "insert": "/data",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The named volume preserves history across container replacement."
        }
      ],
      "children": []
    },
    "b-readme-verify-41": {
      "id": "b-readme-verify-41",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Verify"
        }
      ],
      "children": []
    },
    "b-readme-sh-42": {
      "id": "b-readme-sh-42",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "bun install --frozen-lockfile\nbun run fmt:check\nbun run lint\nbun run check"
        }
      ],
      "children": []
    },
    "b-readme-the-http-smoke-test-need-43": {
      "id": "b-readme-the-http-smoke-test-need-43",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs strict TypeScript checking and verifies the generated TypeScript bindings against OpenAPI. "
        },
        {
          "insert": "lint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs type-aware correctness rules and fails on warnings. When you change Swift or the API on macOS, also run "
        },
        {
          "insert": "bun run generate:api --check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "swift build --force-resolved-versions",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "AGENTS.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " prohibits automated tests and test harnesses. Verify changed behavior with real dictation in Transcriber Dev, as the "
        },
        {
          "insert": "Development",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/40-development"
            }
          }
        },
        {
          "insert": " guide describes."
        }
      ],
      "children": []
    },
    "server-setup-source-server-port": {
      "id": "server-setup-source-server-port",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The source server, "
        },
        {
          "insert": "bun run dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", hot reloads and listens on "
        },
        {
          "insert": "0.0.0.0:8392",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with its data and a private token under "
        },
        {
          "insert": ".local/dev-server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Port 8392 is also the archive viewer's port on Ford's Mac. There, start the source server on a free port, for example "
        },
        {
          "insert": "bun run dev --port 8393",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    }
  }
}
