    "b-readme-from-the-repository-root-22": {
      "id": "b-readme-from-the-repository-root-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "From the repository root, with the models installed above:"
        }
      ],
      "children": []
    },
    "b-readme-sh-23": {
      "id": "b-readme-sh-23",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "./build/server/transcriber-server \\\n  --host 127.0.0.1 --port 8391 \\\n  --data-dir \"$PWD/.local/server\" \\\n  --speech-helper \"$PWD/build/server/helpers/transcriber-engine\" \\\n  --speech-model \"$PWD/.local/models/ggml-large-v3-turbo.bin\" \\\n  --vad-model \"$PWD/build/server/resources/silero-vad.bin\" \\\n  --proof-helper \"$PWD/build/server/helpers/transcriber-text-engine\" \\\n  --proof-model \"$PWD/.local/models/Qwen3-4B-Instruct-2507-MLX-4bit\""
        }
      ],
      "children": []
    },
    "b-readme-on-linux-replace-the-la-24": {
      "id": "b-readme-on-linux-replace-the-la-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "On Linux, replace the last path with the GGUF file. Add "
        },
        {
          "insert": "--dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for a development label in health responses. If using the packaged distribution elsewhere, point helper/resource paths at that package and choose durable model/data paths."
        }
      ],
      "children": []
    },
    "b-readme-check-curl-http-local-25": {
      "id": "b-readme-check-curl-http-local-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Check "
        },
        {
          "insert": "curl http://localhost:8391/v1/health",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". HTTP reachability alone does not mean inference is available. The "
        },
        {
          "insert": "ready",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " field means the server can accept a recording, including while other recordings are uploading or processing. Finished uploads queue for serial inference. Quitting a client does not stop this process. Use launchd, systemd, or container supervision for boot/restart behavior. The scripts do not install a service."
        }
      ],
      "children": []
    },
