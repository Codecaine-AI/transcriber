    "b-readme-this-installs-and-verifi-7": {
      "id": "b-readme-this-installs-and-verifi-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This installs and verifies "
        },
        {
          "insert": "ggml-large-v3-turbo.bin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The URL, revision, and checksum are pinned in "
        },
        {
          "insert": "scripts/download-model.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "Sources/TranscriberCore/SpeechModel.swift",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The server build separately downloads the pinned Silero VAD model."
        }
      ],
      "children": []
    },
    "b-readme-qwen-on-macos-8": {
      "id": "b-readme-qwen-on-macos-8",
