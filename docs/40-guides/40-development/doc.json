      "id": "b-readme-follow-the-server-guide-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Follow the "
        },
        {
          "insert": "server guide",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/20-server-setup"
            }
          }
        },
        {
          "insert": " for macOS, Linux, or containers. On the client Mac, build and open only the app:"
        }
      ],
      "children": []
    },
