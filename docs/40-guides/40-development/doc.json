    "b-readme-set-its-url-and-token-un-17": {
      "id": "b-readme-set-its-url-and-token-un-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Set its URL and token under "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Use HTTPS for remote hosts, or HTTP with the server's literal Tailscale IP on your connected tailnet. The client needs no model weights or GPU for inference. "
        },
        {
          "insert": "build/V07.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " carries upstream's identity. To build the fork's app without installing it, run "
        },
        {
          "insert": "./scripts/rebuild-local.sh --build-only",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which produces "
        },
        {
          "insert": "build/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-readme-daily-development-18": {
      "id": "b-readme-daily-development-18",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Daily development"
        }
      ],
      "children": []
    },
    "dev-source-server-lead": {
      "id": "dev-source-server-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For server edits on macOS or Linux, install dependencies once and run the source with hot reload."
        }
      ],
      "children": []
    },
    "dev-source-server-commands": {
      "id": "dev-source-server-commands",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "bun install --frozen-lockfile\nbun run dev                 # Listens on 0.0.0.0:8392\nbun run dev --port 8393     # On Ford's Mac, where the archive viewer uses 8392"
        }
      ],
      "children": []
    },
    "dev-source-server-notes": {
      "id": "dev-source-server-notes",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The source server keeps its data in "
        },
        {
          "insert": ".local/dev-server/data",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and creates a private token file at "
        },
        {
          "insert": ".local/dev-server/token",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It ignores an inherited "
        },
        {
          "insert": "V07_SERVER_DATA_DIR",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; pass "
        },
        {
          "insert": "--data-dir",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to select another development archive. Without helpers and models the server still starts, and health reports "
        },
        {
          "insert": "ready: false",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". For dictation, build the native helpers once with "
        },
        {
          "insert": "./scripts/build-server.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and set the model-path exports above."
        }
      ],
      "children": []
    },
    "dev-static-checks": {
      "id": "dev-static-checks",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "bun run fmt\nbun run fmt:check\nbun run lint\nbun run check"
        }
      ],
      "children": []
    },
    "dev-no-automated-tests": {
      "id": "dev-no-automated-tests",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "AGENTS.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " prohibits adding, restoring, or running automated tests and test harnesses. Verify behavior by using "
        },
        {
          "insert": "Transcriber Dev",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " on a Mac, in place of the V07 Dev that upstream's "
        },
        {
          "insert": "AGENTS.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "CLAUDE.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " name. The browser health endpoint alone cannot verify dictation or insertion. When you change Swift or the API, also run "
        },
        {
          "insert": "bun run generate:api --check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "swift build --force-resolved-versions",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "dev-packaged-runner-lead": {
      "id": "dev-packaged-runner-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For the packaged Mac app and server, use the dev runner."
        }
      ],
      "children": []
    },
    "b-readme-sh-19": {
      "id": "b-readme-sh-19",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "./scripts/run-dev.sh start --skip-build   # Start existing builds\n./scripts/run-dev.sh status\n./scripts/run-dev.sh stop\n./scripts/run-dev.sh restart             # Rebuild and restart the server"
        }
      ],
      "children": []
    },
    "b-readme-keep-the-model-path-expo-20": {
      "id": "b-readme-keep-the-model-path-expo-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keep the model-path exports set when starting the server. After rebuilding an already-open client, quit and reopen it to load the new executable. The dev runner defaults to port 8391 and "
        },
        {
          "insert": ".local/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which the installed server on Ford's Mac already uses. Before running it beside that installation, set "
        },
        {
          "insert": "V07_SERVER_PORT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to an unused port and "
        },
        {
          "insert": "V07_SERVER_DATA_DIR",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to a separate directory. For frequent changes to the installed app, use the local signing workflow below."
        }
      ],
      "children": []
    },
    "b-readme-the-dev-runner-stores-sh-21": {
      "id": "b-readme-the-dev-runner-stores-sh-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The dev runner stores shared history/settings in "
        },
        {
          "insert": ".local/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", device preferences in "
        },
        {
          "insert": ".local/client",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and logs in "
        },
        {
          "insert": ".local/server.log",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Keep experiment notes and generated artifacts under the ignored "
        },
        {
          "insert": ".local/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directory too. Quitting the app leaves the server running. Recordings require an online, available server and have a three-minute limit."
        }
      ],
      "children": []
    },
    "b-readme-all-connected-macs-share-22": {
      "id": "b-readme-all-connected-macs-share-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "All connected Macs share history, tagged by device. Both original and inference audio are kept by default. "
        },
        {
          "insert": "Keep original microphone audio",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " changes original retention for future takes. Back up the server data directory to preserve history."
        }
      ],
      "children": []
    },
    "dev-transcriber-heading": {
      "id": "dev-transcriber-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Test With Transcriber Dev"
        }
      ],
      "children": []
    },
    "dev-transcriber-lead": {
      "id": "dev-transcriber-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Transcriber Dev is the fork's development build. Its permissions, settings, and Keychain entries are separate from the installed Transcriber, so a test never touches daily dictation. Run it against an isolated source server."
        }
      ],
      "children": []
    },
    "dev-transcriber-commands": {
      "id": "dev-transcriber-commands",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "./scripts/rebuild-local.sh --dev   # Build and sign build/Transcriber Dev.app\n\n# In its own terminal:\nbun run dev --port 8393 \\\n  --speech-model \"$PWD/.local/models/ggml-large-v3-turbo.bin\" \\\n  --proof-model \"$PWD/.local/models/Qwen3-4B-Instruct-2507-MLX-4bit\"\n\nopen --env \"V07_CLIENT_DATA_DIR=$PWD/.local/dev-client\" \\\n  --env \"V07_SERVER_URL=http://127.0.0.1:8393\" \"build/Transcriber Dev.app\""
        }
      ],
      "children": []
    },
    "dev-transcriber-build": {
      "id": "dev-transcriber-build",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "--dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " builds upstream's development app and gives the copy the name Transcriber Dev and the bundle identifier "
        },
        {
          "insert": "ai.codecaine.transcriber.dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": [
        "dev-transcriber-build-sign"
      ]
    },
    "dev-transcriber-build-sign": {
      "id": "dev-transcriber-build-sign",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The installer signs the copy with the pinned local certificate and installs nothing."
        }
      ],
      "children": []
    },
    "dev-transcriber-server": {
      "id": "dev-transcriber-server",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use a free port. On Ford's Mac the installed server uses 8391 and the archive viewer uses 8392."
        }
      ],
      "children": []
    },
    "dev-transcriber-token": {
      "id": "dev-transcriber-token",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The source server requires the token in "
        },
        {
          "insert": ".local/dev-server/token",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Enter it once under "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " in Transcriber Dev."
        }
      ],
      "children": [
        "dev-transcriber-token-keychain"
      ]
    },
    "dev-transcriber-token-keychain": {
      "id": "dev-transcriber-token-keychain",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Transcriber Dev saves the token in the Keychain service "
        },
        {
          "insert": "ai.codecaine.transcriber.dev.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The account is "
        },
        {
          "insert": "<client data dir>|<server address>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "dev-transcriber-permissions": {
      "id": "dev-transcriber-permissions",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Grant Transcriber Dev Microphone and Accessibility the first time it asks."
        }
      ],
      "children": []
    },
    "local-signing-heading": {
      "id": "local-signing-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Rebuild the Installed App"
        }
      ],
      "children": []
    },
    "local-signing-purpose": {
      "id": "local-signing-purpose",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use the installed-app workflow for frequent client customizations. Finish any active dictation before rebuilding, because installation quits and reopens Transcriber. Run commands from the repository root."
        }
      ],
      "children": []
    },
    "signing-everyday-command": {
      "id": "signing-everyday-command",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "cd /Users/Ford/workspace/codecaine/utilities/sotto\n./scripts/rebuild-local.sh --build-only   # Build and sign build/Transcriber.app\n./scripts/rebuild-local.sh                # Build, back up the installed app, replace it, reopen it"
        }
      ],
      "children": []
    },
    "signing-everyday-result": {
      "id": "signing-everyday-result",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The install command builds upstream's app, copies it to "
        },
        {
          "insert": "build/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the Transcriber name and bundle identifier, and signs the copy. It then checks the identity, keeps a rollback copy of any installed Transcriber, and opens "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Wait for \"Installed and opened\" and \"No macOS permissions were reset.\" Then test one sentence with the configured key. Routine rebuilds do not need the setup or adoption commands."
        }
      ],
      "children": []
    },
    "signing-first-setup-heading": {
      "id": "signing-first-setup-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Set Up Signing Once"
        }
      ],
      "children": []
    },
    "local-signing-setup": {
      "id": "local-signing-setup",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Once per Mac, run "
        },
        {
          "insert": "python3 scripts/setup-local-signing.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". If "
        },
        {
          "insert": "~/.config/transcriber/signing.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exists, setup prints the configured identity and changes nothing. Otherwise it reuses a certificate named Transcriber Local Development from the login Keychain or creates one, then verifies the same signing requirement on two distinct probe binaries. Approve a Keychain prompt for codesign if one appears."
        }
      ],
      "children": []
    },
    "local-signing-adopt": {
      "id": "local-signing-adopt",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Install with "
        },
        {
          "insert": "./scripts/rebuild-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The first install on a Mac needs no adoption flag because no Transcriber app exists yet. If you deliberately change the certificate of an installed Transcriber, use "
        },
        {
          "insert": "./scripts/rebuild-local.sh --adopt-identity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for that one replacement. Do not use adoption to bypass an unexplained identity mismatch."
        }
      ],
      "children": []
    },
    "local-signing-rebuild": {
      "id": "local-signing-rebuild",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Grant Microphone and Accessibility when macOS asks. Confirm that "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " in Transcriber shows both as Allowed. Test dictation in a text field before making further changes."
        }
      ],
      "children": []
    },
    "local-signing-limits": {
      "id": "local-signing-limits",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The installer updates the desktop client only. The server and archive worker keep running while the client is replaced. For backend changes, run "
        },
        {
          "insert": "./scripts/build-server.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and restart the server. On Ford's Mac that is the "
        },
        {
          "insert": "ai.codecaine.sotto.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " service, which starts the new build through "
        },
        {
          "insert": "scripts/run-server-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "signing-mechanism-heading": {
      "id": "signing-mechanism-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Why Permissions Survive Rebuilds"
        }
      ],
      "children": []
    },
    "signing-mechanism": {
      "id": "signing-mechanism",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "macOS checks an app's saved code requirement when applying privacy grants. Ad-hoc signing can bind that requirement to an executable hash that changes on rebuild. The installer pins the bundle identifier "
        },
        {
          "insert": "ai.codecaine.transcriber",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the certificate fingerprint instead. A changed executable can satisfy the same requirement. Both stay the same across rebuilds and upstream syncs."
        }
      ],
      "children": []
    },
    "signing-identity-storage": {
      "id": "signing-identity-storage",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "scripts/setup-local-signing.py",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/setup-local-signing.py"
            }
          }
        },
        {
          "insert": " creates a self-signed certificate named Transcriber Local Development with a ten-year validity period. Its private key is imported as non-extractable into the login Keychain. "
        },
        {
          "insert": "~/.config/transcriber/signing.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stores public identity metadata and the Keychain path. The adjacent "
        },
        {
          "insert": "local-signing-certificate.pem",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is public and cannot replace a lost private key. No Apple developer account is needed. This setup does not provide notarized distribution."
        }
      ],
      "children": []
    },
    "signing-identity-this-mac": {
      "id": "signing-identity-this-mac",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "On Ford's Mac the configuration names the certificate created before the rename, Sotto Local Development. Its fingerprint matches the earlier "
        },
        {
          "insert": "~/.config/sotto/signing.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "signing-build-behavior": {
      "id": "signing-build-behavior",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "scripts/build-app.sh",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/build-app.sh"
            }
          }
        },
        {
          "insert": " is upstream's script and does not read the pinned configuration. It signs "
        },
        {
          "insert": "build/V07.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "V07_SIGNING_IDENTITY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " if set, with the Apple Development identity if exactly one exists, or ad hoc. The installer then signs the Transcriber copy with the pinned certificate. A missing key or signing error stops the installer. It never falls back to ad-hoc signing."
        }
      ],
      "children": []
    },
    "signing-installer-behavior": {
      "id": "signing-installer-behavior",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "scripts/rebuild-local.sh",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/rebuild-local.sh"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "scripts/install-local.py",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/install-local.py"
            }
          }
        },
        {
          "insert": ". The installer requires the saved configuration and takes the signing identity only from it. It verifies the built and staged bundles and compares the installed signing requirement before replacement. It stops if "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a symlink or holds an app with another bundle identifier. Identity changes require explicit adoption. It never runs "
        },
        {
          "insert": "tccutil",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or resets permissions."
        }
      ],
      "children": []
    },
    "signing-recovery-heading": {
      "id": "signing-recovery-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Repair an Old Accessibility Entry"
        }
      ],
      "children": []
    },
    "signing-recovery-condition": {
      "id": "signing-recovery-condition",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "After an identity change, System Settings can show an enabled switch while Transcriber still reports access denied. A toggle alone may keep the old code requirement. Use this repair only for that mismatch, not after every rebuild. The first Transcriber install is a new grant, not a repair. A password prompt is not required if Settings already permits the change."
        }
      ],
      "children": []
    },
    "signing-recovery-remove": {
      "id": "signing-recovery-remove",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Open System Settings → Privacy & Security → Accessibility. Select Transcriber.app and click the minus button. This removes the permission entry, not the application."
        }
      ],
      "children": []
    },
    "signing-recovery-add": {
      "id": "signing-recovery-add",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Click the plus button, select /Applications/Transcriber.app, and click Open. Make sure its switch is on and approve any macOS authentication prompt."
        }
      ],
      "children": []
    },
    "signing-recovery-check": {
      "id": "signing-recovery-check",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "In Transcriber → This Mac, click Check again. Confirm Accessibility is Allowed. If the display stays stale, quit and reopen Transcriber, then check again."
        }
      ],
      "children": []
    },
    "signing-recovery-stop": {
      "id": "signing-recovery-stop",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If access remains denied, inspect the signing requirement and permission logs before changing certificates or resetting grants. V07 Dev and the earlier Sotto.app have separate identities. Grant access to the installed Transcriber.app used by this workflow."
        }
      ],
      "children": []
    },
    "signing-verify-heading": {
      "id": "signing-verify-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Check a Rebuild"
        }
      ],
      "children": []
    },
    "signing-verify-commands": {
      "id": "signing-verify-commands",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "codesign --verify --deep --strict /Applications/Transcriber.app\ncodesign -d -r- /Applications/Transcriber.app\nshasum -a 256 /Applications/Transcriber.app/Contents/MacOS/Transcriber\n/usr/bin/log show --last 5m --style compact \\\n  --predicate 'subsystem == \"ai.codecaine.transcriber\" AND category == \"permissions\"'"
        }
      ],
      "children": []
    },
    "signing-verify-expectations": {
      "id": "signing-verify-expectations",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Compare the requirement and executable SHA-256 before and after a source change. The hash should change while the certificate-based designated requirement stays identical. The installed process should log microphone=true, accessibility=true, and hotkey=true. Input Monitoring need not be separately granted when Accessibility already allows the hotkey listener."
        }
      ],
      "children": []
    },
    "signing-verified-scope": {
      "id": "signing-verified-scope",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "On Ford's Mac, Transcriber was installed on 2026-09-30 with the certificate Sotto.app used. Its permissions log reports microphone, accessibility, inputMonitoring, and hotkey as true. An end-to-end dictation worked. A changed-build replacement of Transcriber that keeps its grants has not been tested yet. That check passed earlier on Sotto.app. Full macOS reboot persistence remains untested. Evidence from the Sotto run is kept under "
        },
        {
          "insert": ".local/signing-validation/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and is not included in Git."
        }
      ],
      "children": []
    },
    "signing-preserve-heading": {
      "id": "signing-preserve-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Preserve the Identity and Recover a Build"
        }
      ],
      "children": []
    },
    "signing-preserve": {
      "id": "signing-preserve",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keep the existing Keychain identity, public signing configuration, bundle identifier, and /Applications/Transcriber.app path. Do not regenerate the certificate for ordinary source changes. Copying only the repository or public certificate to another Mac does not transfer the private key. A new certificate or a lost key requires intentional adoption and may require permission approval again."
        }
      ],
      "children": []
    },
    "signing-backup": {
      "id": "signing-backup",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each replacement keeps the previous app in "
        },
        {
          "insert": ".local/install-backups/<timestamp>/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and prints that rollback path. To restore one, quit Transcriber, preserve the current app, and copy the chosen backup to /Applications/Transcriber.app before reopening. A backup signed with an older identity can require permission repair. Backup copies contain the client application, not server history or the transcript archive. Backups made before the rename hold Sotto.app."
        }
      ],
      "children": []
    },
