    "b-readme-this-guide-retains-the-u-1": {
      "id": "b-readme-this-guide-retains-the-u-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This guide follows upstream's "
        },
        {
          "insert": "README.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "docs/development.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which use the name V07. It adds the fork's workflow for building and installing Transcriber, which "
        },
        {
          "insert": "TRANSCRIBER.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " summarizes. Codecaine's archive worker additionally requires Python 3.12 or later. The installed local setup is described in "
        },
        {
          "insert": "Local Setup",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/10-local-setup"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-readme-hold-a-key-speak-and-r-2": {
      "id": "b-readme-hold-a-key-speak-and-r-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Hold a key, speak, and release to insert your dictation. V07 is a native Swift macOS app backed by a Bun-compiled TypeScript/Fastify model server running on the same Mac, another Mac, or Linux. Audio uploads while you speak. The server returns progress and one finished transcript. You can start another take immediately. Finished recordings queue on the server, and each result returns to the client that recorded it."
        }
      ],
      "children": []
    },
    "b-readme-the-dev-runner-builds-3": {
      "id": "b-readme-the-dev-runner-builds-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The dev runner builds V07 Dev, bundle identifier "
        },
        {
          "insert": "dev.davis.v07.dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with separate settings and visible Dev labels. For the installed daily-use app, use "
        },
        {
          "insert": "./scripts/rebuild-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " after the one-time signing setup described below. It installs Transcriber. Both clients connect to an independently running server."
        }
      ],
      "children": []
    },
    "b-readme-get-started-on-one-mac-4": {
      "id": "b-readme-get-started-on-one-mac-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Get started on one Mac"
        }
      ],
      "children": []
    },
    "b-readme-you-need-apple-silicon-5": {
      "id": "b-readme-you-need-apple-silicon-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "You need Apple Silicon, macOS 14+, full Xcode 26+ with the Metal compiler, Bun 1.4.2, CMake, and Git. Xcode provides Swift; the client and MLX build requires Swift 6.2+. Bun manages JavaScript dependencies and builds the standalone server executable. The Codecaine archive worker requires Python 3.12 or later."
        }
      ],
      "children": []
    },
    "b-readme-sh-6": {
      "id": "b-readme-sh-6",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "git clone --recurse-submodules https://github.com/Codecaine-AI/sotto.git\ncd sotto"
        }
      ],
      "children": []
    },
    "b-readme-download-the-pinned-whi-7": {
      "id": "b-readme-download-the-pinned-whi-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Download the pinned Whisper and Qwen models",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/20-server-setup"
            }
          }
        },
        {
          "insert": " into "
        },
        {
          "insert": ".local/models",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then build and start:"
        }
      ],
      "children": []
    },
    "b-readme-sh-8": {
      "id": "b-readme-sh-8",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "export V07_SPEECH_MODEL=\"$PWD/.local/models/ggml-large-v3-turbo.bin\"\nexport V07_TEXT_MODEL=\"$PWD/.local/models/Qwen3-4B-Instruct-2507-MLX-4bit\"\n./scripts/run-dev.sh"
        }
      ],
      "children": []
    },
    "b-readme-use-your-own-model-paths-9": {
      "id": "b-readme-use-your-own-model-paths-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use your own model paths if they are already installed. The script builds the server and client, starts "
        },
        {
          "insert": "http://localhost:8391",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", and opens "
        },
        {
          "insert": "build/V07 Dev.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The first build fetches dependencies and the small Silero speech detector."
        }
      ],
      "children": []
    },
    "b-readme-grant-sotto-dev-micr-10": {
      "id": "b-readme-grant-sotto-dev-micr-10",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Grant "
        },
        {
          "insert": "V07 Dev",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Microphone and Accessibility permissions."
        }
      ],
      "children": []
    },
    "b-readme-wait-for-the-server-to-b-11": {
      "id": "b-readme-wait-for-the-server-to-b-11",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Wait for the server to be ready. Focus a text field, hold "
        },
        {
          "insert": "Right Option",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", speak, and release."
        }
      ],
      "children": []
    },
    "b-readme-change-the-shortcut-unde-12": {
      "id": "b-readme-change-the-shortcut-unde-12",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Change the shortcut and its trigger under "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", and choose inputs under "
        },
        {
          "insert": "Microphone",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Edit shared cleanup instructions or dictionary entries under "
        },
        {
          "insert": "Server preferences",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-readme-test-microphone-show-13": {
      "id": "b-readme-test-microphone-show-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Test microphone",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " shows a result in the app without inserting it. Fn/Globe is also supported. Set macOS "
        },
        {
          "insert": "Keyboard → Press Globe key to → Do Nothing",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " if its system action conflicts."
        }
      ],
      "children": []
    },
