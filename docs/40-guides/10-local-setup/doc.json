    "b-10-local-setup-the-archive-is-users-f-8": {
      "id": "b-10-local-setup-the-archive-is-users-f-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The archive is "
        },
        {
          "insert": "/Users/Ford/Transcripts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It is local to this Mac pending a cloud-folder choice. It lives outside the repository and is usable by other local tools. Browser viewer: http://127.0.0.1:8392."
        }
      ],
      "children": []
    },
    "b-10-local-setup-each-record-contains-ra-9": {
      "id": "b-10-local-setup-each-record-contains-ra-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each record contains "
        },
        {
          "insert": "raw.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "clean.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "metadata.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", original source versions, and available attachments. Missing original text remains marked as missing. The Data page supports full-archive search, source filters, raw/clean comparison, audio playback, screenshots, all saved fields, dictionaries, original export files, and migration checks."
        }
      ],
      "children": []
    },
    "b-10-local-setup-the-archive-has-no-artif-10": {
      "id": "b-10-local-setup-the-archive-has-no-artif-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The archive has no artifact-size cap. Its one-time Wispr migration bypasses the legacy upstream HTTP importer's 8 MiB restriction. The live dictation limit remains 180 seconds per take. This is separate from archive storage."
        }
      ],
      "children": []
    },
    "b-10-local-setup-new-completed-failed-a-11": {
      "id": "b-10-local-setup-new-completed-failed-a-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "New completed, failed, and cancelled dictation records are copied every three seconds. Deleting a record in the app's history does not delete its archived copy. The searchable SQLite index is a disposable local cache; portable files are authoritative. Use one writer on this Mac."
        }
      ],
      "children": []
    },
