    "b-10-local-setup-startup-at-login-is-off-20": {
      "id": "b-10-local-setup-startup-at-login-is-off-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Three LaunchAgents in "
        },
        {
          "insert": "~/Library/LaunchAgents",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " start the app, the dictation server, and the archive worker at login: "
        },
        {
          "insert": "ai.codecaine.sotto.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "ai.codecaine.sotto.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "ai.codecaine.sotto.archive",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The app agent opens "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The server agent runs "
        },
        {
          "insert": "scripts/run-server-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which starts the packaged server in "
        },
        {
          "insert": "build/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Quitting the app leaves the server and archive worker running. Sotto's own login item for "
        },
        {
          "insert": "dev.davis.murmur",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is still registered and points at the missing app."
        }
      ],
      "children": []
    },
    "b-10-local-setup-wispr-history-was-migrat-21": {
      "id": "b-10-local-setup-wispr-history-was-migrat-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Wispr Flow is quit and removed from login startup. Its nightly WisprSync job is disabled. A final import and integrity check preserved the available history and dictionary entries. The app and source data remain installed. Only new dictation records are monitored automatically."
        }
      ],
      "children": []
    },
