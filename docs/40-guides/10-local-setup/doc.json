    "b-10-local-setup-open-start-sotto-comma-3": {
      "id": "b-10-local-setup-open-start-sotto-comma-3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Open "
        },
        {
          "insert": ".local/Start Transcriber.command",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the repository. It starts the dictation server and the archive worker and opens "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The older "
        },
        {
          "insert": ".local/Start Sotto.command",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " still exists but opens the removed Sotto.app."
        }
      ],
      "children": []
    },
    "b-10-local-setup-choose-data-in-sotto-4": {
      "id": "b-10-local-setup-choose-data-in-sotto-4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Choose "
        },
        {
          "insert": "Data",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " in the app to browse the shared transcript archive."
        }
      ],
      "children": []
    },
    "b-10-local-setup-for-dictation-open-di-5": {
      "id": "b-10-local-setup-for-dictation-open-di-5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "For dictation, focus a text field, hold the configured key, speak, and release. The key on this Mac is fn. "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " shows the current key and trigger mode."
        }
      ],
      "children": []
    },
    "b-10-local-setup-the-updated-app-may-need-6": {
      "id": "b-10-local-setup-the-updated-app-may-need-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For client changes, run "
        },
        {
          "insert": "./scripts/rebuild-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from the repository root. It rebuilds and replaces Transcriber. The "
        },
        {
          "insert": "Development",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/40-development"
            }
          }
        },
        {
          "insert": " guide covers one-time certificate setup, how signing preserves permissions, recovery for stale Accessibility entries, and verification commands. The signing configuration on this Mac is "
        },
        {
          "insert": "~/.config/transcriber/signing.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
