    "local-signing-validation-scope": {
      "id": "local-signing-validation-scope",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Transcriber is signed with the certificate that signed Sotto.app. Its permissions log reports microphone, accessibility, inputMonitoring, and hotkey as true. Microphone was allowed from the system prompt. Accessibility was granted in System Settings. On 2026-09-30 an end-to-end dictation worked: hold fn, speak, and the text was inserted. A full macOS reboot has not been tested. Preserve the local certificate for future rebuilds."
        }
      ],
      "children": []
    },
