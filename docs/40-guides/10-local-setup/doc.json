    "b-10-local-setup-this-guide-describes-the-1": {
      "id": "b-10-local-setup-this-guide-describes-the-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This guide describes the Codecaine installation on Ford's Mac. The installed client is "
        },
        {
          "insert": "/Applications/Transcriber.app",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", installed on 2026-09-30 with "
        },
        {
          "insert": "./scripts/rebuild-local.sh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The earlier Sotto.app is kept in "
        },
        {
          "insert": ".local/cutover-backup-20260930-115949/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "Current Status",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "00-foundation/20-current-status"
            }
          }
        },
        {
          "insert": " records the cutover and how to roll it back."
        }
      ],
      "children": []
    },
