          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "bun run fmt:check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "bun run lint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "bun run check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " before you commit."
        }
