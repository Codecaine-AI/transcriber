        },
        {
          "insert": ".local/dev-client/tmp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The installed app sets no "
        },
        {
          "insert": "TRANSCRIBER_CLIENT_DATA_DIR",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so it keeps its files in "
        },
        {
          "insert": "$TMPDIR",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
