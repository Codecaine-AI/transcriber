    "b-20-agents-the-product-has-no-auton-1": {
      "id": "b-20-agents-the-product-has-no-auton-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The product has no autonomous agent framework or background LLM agent. Its persistent Whisper and Qwen helpers perform bounded inference requested by the server."
        }
      ],
      "children": []
    },
    "b-20-agents-whisper-transcribes-uplo-2": {
      "id": "b-20-agents-whisper-transcribes-uplo-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Whisper transcribes uploaded audio. It does not open a microphone or network connection."
        }
      ],
      "children": []
    },
    "b-20-agents-qwen-proposes-cleaned-te-3": {
      "id": "b-20-agents-qwen-proposes-cleaned-te-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Qwen proposes cleaned text under the configured prompt. Deterministic server checks decide whether to accept the proposal."
        }
      ],
      "children": []
    },
    "b-20-agents-the-archive-worker-is-a-4": {
      "id": "b-20-agents-the-archive-worker-is-a-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The archive worker is a deterministic Python process. It copies finished records and serves read-only data; it is not an AI agent."
        }
      ],
      "children": []
    },
    "b-20-agents-developer-assistants-sho-5": {
      "id": "b-20-agents-developer-assistants-sho-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Developer assistants should inspect "
        },
        {
          "insert": "Current Status",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "00-foundation/20-current-status"
            }
          }
        },
        {
          "insert": ", preserve private datasets and unrelated work, and use typed Docs tools for corpus edits. New product agents need explicit definitions here before their behavior is treated as implemented."
        }
      ],
      "children": []
    },
    "agents-developer-checks": {
      "id": "agents-developer-checks",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "AGENTS.md",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "AGENTS.md"
            }
          }
        },
        {
          "insert": " sets the repository rules for developer assistants. It prohibits adding, restoring, or running automated tests. The checks are "
        },
        {
          "insert": "bun run check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "bun run lint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "bun run fmt:check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Assistants verify runtime behavior through Transcriber Dev against an isolated development server, as "
        },
        {
          "insert": "Development",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/40-development"
            }
          }
        },
        {
          "insert": " describes, and run "
        },
        {
          "insert": "bun run fmt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " after editing TypeScript. Bun 1.4.2 is required."
        }
      ],
