      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Migration began September 16, 2026 at 09:48 AM CDT. Each database was read through a consistent SQLite snapshot. A subsequent independent comparison found zero new or changed current rows and zero changed backup rows at verification time. The exact checks are in "
        },
        {
          "insert": "Sotto Migration Verification.json",
          "attributes": {
