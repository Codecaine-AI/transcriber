    "b-30-migration-verification-each-record-stores-raw-9": {
      "id": "b-30-migration-verification-each-record-stores-raw-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each record stores "
        },
        {
          "insert": "raw.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "clean.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "metadata.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Original ASR text is the raw version. Current Wispr clean text is selected from pasted, server-finalized, formatted, then ASR text. All other source text variants remain in metadata. Sotto raw and clean files mirror its raw recognition and final accepted text."
        }
      ],
      "children": []
    },
    "b-30-migration-verification-no-text-or-dates-are-inv-10": {
      "id": "b-30-migration-verification-no-text-or-dates-are-inv-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "No text or dates are invented. Missing text is represented by an empty portable text file and an explicit null in metadata. The archive contains 26 entries with unknown dates, including source rows without valid identifiers."
        }
      ],
      "children": []
    },
    "b-30-migration-verification-there-are-1-215-entries-11": {
      "id": "b-30-migration-verification-there-are-1-215-entries-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There are 1,215 entries with audio and 190 with screenshots. Source versions keep original SQLite types, every History field, and streamed media references. The archive also preserves 92 export-level files, including dictionaries, manifests, indexes, and run reports."
        }
      ],
      "children": []
    },
