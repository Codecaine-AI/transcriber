    "b-30-migration-verification-repeated-records-share-a-7": {
      "id": "b-30-migration-verification-repeated-records-share-a-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Repeated records share archive folders when their source IDs match. Rows without valid IDs are kept. Unidentified rows from different database files remain separate to avoid guessing that they are the same recording. Therefore, archive-entry counts are not a count of unique spoken utterances."
        }
      ],
      "children": []
    },
