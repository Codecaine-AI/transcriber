    "b-30-migration-verification-only-sotto-is-monitored-18": {
      "id": "b-30-migration-verification-only-sotto-is-monitored-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Only Sotto is monitored by the new worker. Finished recordings are archived every three seconds, and archived copies survive deletion from Sotto. Raw/clean archive equality and repeat-copy behavior passed for two real-audio test recordings in an isolated test dataset. Production data contains no synthetic test recordings."
        }
      ],
      "children": []
    },
    "b-30-migration-verification-wispr-flow-and-the-exist-19": {
      "id": "b-30-migration-verification-wispr-flow-and-the-exist-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Wispr Flow and the existing nightly WisprSync job remain unchanged. Any Wispr recordings made after this migration require a final catch-up export before retiring Wispr. The archive's file format remains portable; search uses a separate rebuildable local cache. One Mac writes the archive."
        }
      ],
      "children": []
    },
