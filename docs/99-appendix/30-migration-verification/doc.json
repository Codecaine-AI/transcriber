    "b-30-migration-verification-the-new-archive-has-no-14": {
      "id": "b-30-migration-verification-the-new-archive-has-no-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The new archive has "
        },
        {
          "insert": "no artifact-size cap",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". It streams files in 1 MiB chunks. The chunk size does not limit the file size. Legacy upstream HTTP import code still contains its old bound and is not used by this migration or exposed as the history import action. Sotto's separate live dictation limit remains 180 seconds per take."
        }
      ],
      "children": []
    },
