      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Add a root Bun workspace/package and pinned lockfile. All JavaScript dependency installation, scripts, static checks, and executable compilation use Bun."
        }
      ],
      "children": []
    },
