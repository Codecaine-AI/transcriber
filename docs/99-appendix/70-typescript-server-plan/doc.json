    "b-typescript-server-plan-keep-the-native-swift-cl-2": {
      "id": "b-typescript-server-plan-keep-the-native-swift-cl-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keep the native Swift client and replace the packaged HTTP coordinator with TypeScript, Fastify, and a Bun executable. Preserve API v1, existing archive layout, text behavior, and native inference helpers. The reference Swift server and domain packages remain available for source comparison. Verification follows "
        },
        {
          "insert": "the development guide",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/50-source-development",
              "label": "the development guide"
            }
          }
        },
        {
          "insert": "; automated tests are not allowed."
        }
      ],
      "children": []
    },
