    "b-10-work-record-the-review-compared-upst-8": {
      "id": "b-10-work-record-the-review-compared-upst-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The review compared upstream PR #4 with WisprSync revision "
        },
        {
          "insert": "8f24c4af5042fbb4d2d1de2348e8dd07b6aafc1a",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It found that the legacy importer could omit three WAVs above 8 MiB, reject undated records, skip invalid IDs, and omit WisprSync export evidence. The initial audit proposed named datasets. Ford selected one permanent raw/clean archive and a one-time Wispr migration instead."
        }
      ],
      "children": []
    },
    "b-10-work-record-the-working-branch-code-9": {
      "id": "b-10-work-record-the-working-branch-code-9",
