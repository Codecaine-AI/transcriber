        {
          "insert": " incorporated upstream merge "
        },
        {
          "insert": "c1d5f0bbaff19a1559621943dff49ba89b4a96a0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The TypeScript replacement in PR #5 was not used."
        }
      ],
      "children": []
    },
