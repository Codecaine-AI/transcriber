      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Start an isolated source instance with "
        },
        {
          "insert": "bun run dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and follow "
        },
        {
          "insert": "the development guide",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/50-source-development",
              "label": "the development guide"
            }
          }
