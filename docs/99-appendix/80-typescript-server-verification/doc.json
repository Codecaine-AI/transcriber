      "id": "tsv-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "These checks verify the Bun TypeScript server before a change merges. They cover static checks, generated Swift bindings, computer-use verification in "
        },
        {
          "insert": "Transcriber Dev",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", and the platforms that need their own hardware."
        }
      ],
      "children": []
    },
    "b-typescript-server-validation-run-bun-run-check-for-2": {
      "id": "b-typescript-server-validation-run-bun-run-check-for-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Run "
        },
        {
          "insert": "bun run check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for strict TypeScript and generated TypeScript/OpenAPI consistency, "
        },
        {
          "insert": "bun run lint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for type-aware correctness, and "
        },
        {
          "insert": "bun run fmt:check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for formatting."
        }
      ],
      "children": []
    },
    "b-typescript-server-validation-verify-generated-swift-b-3": {
      "id": "b-typescript-server-validation-verify-generated-swift-b-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Verify generated Swift bindings with "
        },
        {
          "insert": "bun run generate:api --check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and compile with "
        },
        {
          "insert": "swift build --force-resolved-versions",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on macOS with Swift 6.2+. CI also compiles standalone coordinators and complete CPU packages for supported platforms."
        }
      ],
      "children": []
    },
