          "attributes": {
            "code": true
          }
        },
        {
          "insert": " flag, the launchd labels "
        },
        {
          "insert": "ai.codecaine.sotto.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "ai.codecaine.sotto.archive",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the repository name "
        },
        {
          "insert": "Codecaine-AI/sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
