    "b-10-product-direction-the-product-captures-spe-1": {
      "id": "b-10-product-direction-the-product-captures-spe-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The product captures speech, preserves the original recognition, and produces cleaned text for insertion. Ford intends to stop using Wispr Flow and develop this fork as the replacement. The fork installs its app under the name Transcriber."
        }
      ],
      "children": []
    },
    "b-10-product-direction-accepted-decisions-2": {
      "id": "b-10-product-direction-accepted-decisions-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Accepted Decisions"
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-permanent-archive-co-3": {
      "id": "b-10-product-direction-the-permanent-archive-co-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The permanent archive contains historical Wispr data and future Transcriber recordings, with raw and clean formats, every available source field, and attachments."
        }
      ],
      "children": []
    },
    "b-10-product-direction-archive-data-is-a-first-4": {
      "id": "b-10-product-direction-archive-data-is-a-first-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Archive data is a first-class dataset with its own manifest, source evidence, integrity reports, and Data page. Named curated collections were proposed during the audit but were not selected for this phase."
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-archive-has-no-artif-5": {
      "id": "b-10-product-direction-the-archive-has-no-artif-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The archive has no artifact-size cap. It must keep oversized audio, unknown dates, malformed source IDs, and source versions rather than silently omit them."
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-working-archive-stay-6": {
      "id": "b-10-product-direction-the-working-archive-stay-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The working archive stays local at "
        },
        {
          "insert": "/Users/Ford/Transcripts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Dropbox was intended as automatic backup. A home NAS is planned, but no backup destination, schedule, or retention policy has been configured."
        }
      ],
      "children": []
    },
    "b-10-product-direction-the-fork-lives-under-co-7": {
      "id": "b-10-product-direction-the-fork-lives-under-co-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The fork's GitHub repository is "
        },
        {
          "insert": "Codecaine-AI/sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and its checkout is "
        },
        {
          "insert": "/Users/Ford/workspace/codecaine/utilities/sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Preserve upstream attribution and keep personal data, model weights, and local runtime configuration out of Git."
        }
      ],
      "children": []
    },
    "decision-deepgram": {
      "id": "decision-deepgram",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Deepgram "
        },
        {
          "insert": "nova-3",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the primary speech recognizer, and local Whisper "
        },
        {
          "insert": "large-v3-turbo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the fallback."
        }
      ],
      "children": [
        "decision-deepgram-why",
        "decision-deepgram-fork",
        "decision-deepgram-off",
        "decision-deepgram-english"
      ]
    },
    "decision-deepgram-why": {
      "id": "decision-deepgram-why",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Ford chose Deepgram on 2026-10-05 because it is faster and more accurate than local Whisper."
        }
      ],
      "children": []
    },
    "decision-deepgram-fork": {
      "id": "decision-deepgram-fork",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Upstream V07 recognizes speech with local Whisper only, so this routing is a fork difference."
        }
      ],
      "children": []
    },
    "decision-deepgram-off": {
      "id": "decision-deepgram-off",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Turning off "
        },
        {
          "insert": "Transcribe with Deepgram",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " in Preferences restores local-only recognition, and audio stays on the Mac."
        }
      ],
      "children": []
    },
    "decision-deepgram-english": {
      "id": "decision-deepgram-english",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Transcriber dictates English only, so Preferences has no "
        },
        {
          "insert": "Language",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " picker. The "
        },
        {
          "insert": "language",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " field stays in the API for upstream compatibility."
        }
      ],
      "children": []
    },
    "naming-heading": {
      "id": "naming-heading",
      "type": "heading",
      "props": {
        "level": 2
