    "naming-lead": {
      "id": "naming-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Three names are in use. Transcriber is the fork's installed app. V07 is upstream's project, modules, environment variable prefix, and development app. Sotto is the earlier upstream name, which the fork keeps in a fixed set of identifiers."
        }
      ],
      "children": []
    },
    "naming-identity": {
      "id": "naming-identity",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The installed app has a fixed identity: the name Transcriber and the bundle identifier "
        },
        {
          "insert": "ai.codecaine.transcriber",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". macOS permissions, the client settings directory, and the Keychain service follow the bundle identifier and name. Upstream's rename to V07 changed its bundle identifier to "
        },
        {
          "insert": "dev.davis.v07",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which macOS treats as a different app. A fixed identity keeps an upstream rename from changing what macOS sees."
        }
      ],
      "children": []
    },
