        },
        {
          "insert": ", "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "text",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", audio "
        },
        {
          "insert": "duration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", processing "
        },
        {
          "insert": "elapsed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", detected "
        },
        {
          "insert": "language",
          "attributes": {
