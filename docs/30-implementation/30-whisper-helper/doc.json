      },
      "text": [
        {
          "insert": "Progress: "
        },
        {
          "insert": "{\"type\":\"progress\",\"id\":\"request-1\",\"value\":0.5}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
