    "b-readme-sotto-engine-is-the-se-1": {
      "id": "b-readme-sotto-engine-is-the-se-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "transcriber-engine",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the server's persistent whisper.cpp process. It reads audio files supplied by the server and never opens a microphone or network connection. Builds use Metal on macOS and CPU or CUDA on Linux. See "
        },
        {
          "insert": "server setup",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/20-server-setup"
            }
          }
        },
        {
          "insert": " for packaging and models."
        }
      ],
      "children": []
    },
    "b-readme-protocol-2": {
      "id": "b-readme-protocol-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Protocol"
        }
      ],
      "children": []
    },
    "b-readme-after-loading-whisper-an-3": {
      "id": "b-readme-after-loading-whisper-an-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "After loading Whisper and Silero VAD, the helper emits a "
        },
        {
          "insert": "ready",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " JSON object with an "
        },
        {
          "insert": "engineVersion",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Send one UTF-8 JSON object per line on stdin. Replies are flushed JSON lines on stdout. Diagnostics go to stderr without transcript text."
        }
      ],
      "children": []
    },
    "b-readme-json-4": {
      "id": "b-readme-json-4",
      "type": "code",
      "props": {
        "language": "json"
      },
      "text": [
        {
          "insert": "{\"type\":\"transcribe\",\"id\":\"request-1\",\"path\":\"/absolute/path/to/recording.wav\",\"language\":\"en\",\"vocabularyTerms\":[\"Transcriber\",\"SwiftUI\",\"Metal\"]}"
        }
      ],
      "children": []
    },
    "b-readme-language-defaults-to-5": {
      "id": "b-readme-language-defaults-to-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "language",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defaults to "
        },
        {
          "insert": "en",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "auto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " enables language detection."
        }
      ],
      "children": []
    },
    "b-readme-vocabularyterms-is-an-6": {
      "id": "b-readme-vocabularyterms-is-an-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "vocabularyTerms",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is an ordered list of recognition hints. Whole terms are fitted into the loaded model's token budget. Responses report "
        },
        {
          "insert": "includedTerms",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "omittedTerms",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "tokenCount",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "tokenBudget",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-readme-wav-input-must-be-mono-1-7": {
      "id": "b-readme-wav-input-must-be-mono-1-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "WAV input must be mono 16 kHz PCM16 or float32, 0.2–180 seconds long. The HTTP server uses a 0.25-second minimum."
        }
      ],
      "children": []
    },
    "b-readme-progress-type-prog-8": {
      "id": "b-readme-progress-type-prog-8",
      "type": "list-item",
      "props": {
