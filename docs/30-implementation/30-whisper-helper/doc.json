    "b-readme-errors-contain-type-e-10": {
      "id": "b-readme-errors-contain-type-e-10",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Errors contain "
        },
        {
          "insert": "type: \"error\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "message",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a request "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when available. Requests are processed sequentially."
        }
      ],
      "children": []
