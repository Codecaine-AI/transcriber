    },
    "b-40-transcript-archive-the-read-only-viewer-bin-12": {
      "id": "b-40-transcript-archive-the-read-only-viewer-bin-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The read-only viewer binds to "
        },
        {
          "insert": "127.0.0.1:8392",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It provides full-archive raw/clean/app search, source filtering, 50-record pages, all transcript variants, typed source fields, audio playback, screenshots, hashes, source versions, dictionary files, and dataset evidence. Foreign Host and Origin requests and path escapes are rejected. Unknown attachment formats download as opaque bytes."
        }
      ],
      "children": []
    },
    "archive-viewer-port": {
      "id": "archive-viewer-port",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The source server, started with "
        },
        {
          "insert": "bun run dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", also defaults to port 8392. On a Mac that runs the viewer, start the source server with another "
        },
        {
          "insert": "--port",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " value."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-storage-and-backup-13": {
