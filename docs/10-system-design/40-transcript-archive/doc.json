    "b-40-transcript-archive-the-worker-polls-sotto-e-9": {
      "id": "b-40-transcript-archive-the-worker-polls-sotto-e-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker polls the dictation server's data directory every three seconds and archives completed, failed, and cancelled records. It records source metadata versions and available sealed audio. A missing referenced file produces a visible error and a retry; removing an operational recording never removes its archived copy. The worker does not monitor Wispr after migration."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-sotto-writes-explicit-ra-10": {
      "id": "b-40-transcript-archive-sotto-writes-explicit-ra-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The server writes explicit raw and clean files before publishing terminal metadata. The worker uses metadata changes to discover updates. This is one writer on this Mac. Synchronizing the folder does not establish multiwriter safety."
        }
      ],
      "children": []
    },
    "archive-retained-names": {
      "id": "archive-retained-names",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Transcriber records keep the source ID "
        },
        {
          "insert": "sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and live under "
        },
        {
          "insert": "records/sotto/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The worker's "
        },
        {
          "insert": "--sotto-data",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " flag and the launchd label "
        },
        {
          "insert": "ai.codecaine.sotto.archive",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " also keep the name. Stored records and the running service depend on these identifiers, so the app's name does not change them. The viewer displays the "
        },
        {
          "insert": "sotto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " source as Transcriber."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-data-viewer-11": {
      "id": "b-40-transcript-archive-data-viewer-11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
