    "b-40-transcript-archive-the-archive-is-the-autho-1": {
      "id": "b-40-transcript-archive-the-archive-is-the-autho-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The archive is the authoritative portable dataset for historical Wispr records and finished Transcriber recordings. Search uses a separate rebuildable SQLite cache. Original files remain usable without the viewer."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-preservation-contract-2": {
      "id": "b-40-transcript-archive-preservation-contract-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Preservation Contract"
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-every-entry-has-metadat-3": {
      "id": "b-40-transcript-archive-every-entry-has-metadat-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Every entry has "
        },
        {
          "insert": "metadata.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "raw.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "clean.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Metadata distinguishes null from empty text, records the selected clean variant, and keeps other variants."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-source-versions-and-atta-4": {
      "id": "b-40-transcript-archive-source-versions-and-atta-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Source versions and attachments use SHA-256 names. Original SQLite types and all available History columns are kept. Repeated identical attachments share a file, with original names kept in metadata."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-media-is-streamed-in-1-m-5": {
      "id": "b-40-transcript-archive-media-is-streamed-in-1-m-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Media is streamed in 1 MiB chunks without a file-size ceiling. Missing dates stay null. Invalid IDs receive stable safe names; missing IDs include source filename and row ID to avoid guessing cross-file identity."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-the-migration-reads-the-6": {
      "id": "b-40-transcript-archive-the-migration-reads-the-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The migration reads the existing WisprSync export, a consistent read-only snapshot of the live database, and complete backups. Export manifests, indexes, run history, dictionary rows, original hashes, and listed files survive."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-current-wispr-clean-text-7": {
      "id": "b-40-transcript-archive-current-wispr-clean-text-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Current Wispr clean text selects nonempty pasted text, server-finalized text, formatted text, then ASR text. Transcriber records use the server's raw recognition and final accepted result."
        }
      ],
      "children": []
    },
