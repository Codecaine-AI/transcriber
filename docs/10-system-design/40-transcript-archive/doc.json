    },
    "b-40-transcript-archive-users-ford-transcripts-14": {
      "id": "b-40-transcript-archive-users-ford-transcripts-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "/Users/Ford/Transcripts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the working archive. The local search cache remains in the repository's ignored "
        },
        {
          "insert": ".local/archive-cache",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The existing three-minute live recording limit and legacy HTTP import bound are independent of unlimited archive artifact storage."
        }
      ],
      "children": []
    },
    "b-40-transcript-archive-automatic-backup-is-not-15": {
      "id": "b-40-transcript-archive-automatic-backup-is-not-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Automatic backup is not configured. Dropbox is a proposed backup destination because Ford wants automatic off-device protection. Permissions concerns favor keeping the working archive local. A home NAS is planned. Version retention, scheduling, backup-failure visibility, and a restore test still require implementation. No cloud upload or NAS setup has been completed."
        }
      ],
      "children": []
    }
