    "b-text-correction-the-server-processes-eac-1": {
      "id": "b-text-correction-the-server-processes-eac-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The server processes each complete take in this order: Whisper → mechanical cleanup → dictionary → list formatting → optional Qwen → dictionary → rewrite validation → composition. The Mac receives a finished result for insertion. Models and installation are covered in the "
        },
        {
          "insert": "server guide",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/20-server-setup"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-text-correction-dictionary-and-vocabular-2": {
      "id": "b-text-correction-dictionary-and-vocabular-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Dictionary and vocabulary"
        }
      ],
      "children": []
    },
    "b-text-correction-edit-server-preference-3": {
      "id": "b-text-correction-edit-server-preference-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Edit "
        },
        {
          "insert": "Server preferences",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", then "
        },
        {
          "insert": "Save shared preferences",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". All dictionary lists are active. Each generation freezes the settings when the server accepts it. Later edits apply to future takes."
        }
      ],
      "children": []
    },
    "b-text-correction-preferred-spellings-norm-4": {
      "id": "b-text-correction-preferred-spellings-norm-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Preferred spellings normalize case. Explicit aliases replace whole words or phrases, such as "
        },
        {
          "insert": "mini max → MiniMax",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Longer matches win, and replacements do not cascade."
        }
      ],
      "children": []
    },
    "b-text-correction-use-narrow-aliases-like-5": {
      "id": "b-text-correction-use-narrow-aliases-like-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use narrow aliases like "
        },
        {
          "insert": "off middleware → auth middleware",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A broad "
        },
        {
          "insert": "off → auth",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " also changes legitimate \"turn off.\""
        }
      ],
      "children": []
    },
    "b-text-correction-star-priority-terms-to-s-6": {
      "id": "b-text-correction-star-priority-terms-to-s-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Star priority terms to suggest them first. Whisper fits whole terms into its token budget. History shows included and omitted hints. Qwen has a separate bounded hint budget. Dictionary replacements still apply to terms omitted from model hints."
        }
      ],
      "children": []
    },
    "b-text-correction-recognition-vocabulary-7": {
      "id": "b-text-correction-recognition-vocabulary-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Recognition vocabulary",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " adds speech hints. Hints improve the odds of recognizing unusual names; they cannot reliably distinguish every homophone."
        }
      ],
      "children": []
    },
    "b-text-correction-the-initial-personal-lis-8": {
      "id": "b-text-correction-the-initial-personal-lis-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The initial Personal list contains MiniMax and Codex. You can delete them or save an empty dictionary. There is no automatic learning from edits or history."
        }
      ],
      "children": []
    },
    "b-text-correction-cleanup-instructions-9": {
      "id": "b-text-correction-cleanup-instructions-9",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Cleanup instructions"
        }
      ],
      "children": []
    },
    "b-text-correction-the-shared-cleanup-ins-10": {
      "id": "b-text-correction-the-shared-cleanup-ins-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The shared "
        },
        {
          "insert": "Cleanup instructions",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " field is the Qwen system prompt. Its default has four freely editable sections: Cleanup, Spoken corrections, Preserve, and Output. It keeps intentional “like,” repetition, answers, numbers, and negations, while allowing explicit spoken corrections. Examples distinguish “42, sorry, 24” from a contrast such as “42, not 24.” It also forbids translation and added information."
        }
      ],
      "children": []
    },
    "b-text-correction-reset-to-default-loa-11": {
      "id": "b-text-correction-reset-to-default-loa-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Reset to default",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " loads a draft. "
        },
        {
          "insert": "Save shared preferences",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " applies it to future takes across clients. Existing custom prompts remain unchanged until edited or reset. Disabling "
        },
        {
          "insert": "Proofread with Qwen",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " keeps the deterministic dictionary/list result, including fillers."
        }
      ],
      "children": []
    },
    "b-text-correction-the-prompt-guides-qwen-12": {
      "id": "b-text-correction-the-prompt-guides-qwen-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The prompt guides Qwen; it cannot bypass the validation rules below."
        }
      ],
      "children": []
    },
    "b-text-correction-preservation-checks-13": {
      "id": "b-text-correction-preservation-checks-13",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Preservation checks"
        }
      ],
      "children": []
    },
    "b-text-correction-list-formatting-preserve-14": {
      "id": "b-text-correction-list-formatting-preserve-14",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "List formatting preserves standalone numeric answers and spoken numbering, including resumed, skipped, repeated, or out-of-order numbers. Qwen cannot create or advance list continuation state."
        }
      ],
      "children": []
    },
    "b-text-correction-cleanup-rejects-changed-15": {
      "id": "b-text-correction-cleanup-rejects-changed-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Cleanup rejects changed list markers, unsupported dictionary names, lost answers, changed quantities/negations, excessive wording changes, and model control tokens or response preambles."
        }
      ],
      "children": []
    },
    "b-text-correction-explicit-corrections-can-16": {
      "id": "b-text-correction-explicit-corrections-can-16",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Explicit corrections can remove an abandoned phrase only when bounded alignment verifies the cue and replacement. Ambiguous apologies or clause restarts can fall back to the source. Unrelated wording remains protected."
        }
      ],
      "children": []
    },
    "b-text-correction-near-spelling-and-suppor-17": {
      "id": "b-text-correction-near-spelling-and-suppor-17",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Near-spelling and supported split-name corrections can pass; more ambiguous names should use explicit aliases. This conservative matching prevents a dictionary hint from licensing an invented name."
        }
      ],
      "children": []
    },
    "b-text-correction-rejected-unavailable-o-18": {
      "id": "b-text-correction-rejected-unavailable-o-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Rejected, unavailable, or failed proofreading keeps the already-cleaned, dictionary-corrected, list-formatted source. History records raw text, the proposed/accepted cleanup, its outcome/reason, verified corrections, and model details. See "
        },
        {
          "insert": "storage",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-architecture"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-text-correction-the-checks-do-not-prove-19": {
      "id": "b-text-correction-the-checks-do-not-prove-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The checks do not prove identical meaning. Whisper can omit words; Qwen can mishandle homophones or instructions. The proofreader receives the current dictated chunk, language, preferred terms, and cleanup prompt. It does not receive surrounding documents, clipboard contents, or screenshots."
        }
      ],
      "children": []
    },
    "b-text-correction-limits-and-testing-20": {
      "id": "b-text-correction-limits-and-testing-20",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Limits and Verification"
        }
      ],
      "children": []
    },
    "b-text-correction-the-prompt-limit-is-4-09-21": {
      "id": "b-text-correction-the-prompt-limit-is-4-09-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The prompt limit is 4,096 UTF-8 bytes. Qwen input is capped at 6,000 characters; its context is 8,192 tokens with 2,048 reserved for output. Oversized text, vocabulary, or validation work skips/rejects cleanup instead of accepting truncated output. The "
        },
        {
          "insert": "helper protocol",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation/40-qwen-helpers"
            }
          }
        },
        {
          "insert": " lists lower-level bounds."
        }
      ],
      "children": []
    },
    "b-text-correction-run-swift-test-for-dic-22": {
      "id": "b-text-correction-run-swift-test-for-dic-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use "
        },
        {
          "insert": "Transcriber Dev",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " to dictate names, numbers, negations, lists, and spoken corrections. Inspect the raw text, proposed cleanup, accepted result, and rejection reasons in history. Edit and save cleanup instructions to exercise custom prompts. Run "
        },
        {
          "insert": "bun run check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "bun run lint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "bun run fmt:check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for static validation. "
        },
        {
          "insert": "AGENTS.md",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " prohibits automated tests and helper harnesses. The "
        },
        {
          "insert": "Development",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/40-development"
            }
          }
        },
        {
          "insert": " guide has the setup."
        }
      ],
      "children": []
    },
    "b-text-correction-open-question-omitted-n-23": {
      "id": "b-text-correction-open-question-omitted-n-23",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Open question: omitted negations"
        }
      ],
      "children": []
    },
    "b-text-correction-audio-rechecking-is-defe-24": {
      "id": "b-text-correction-audio-rechecking-is-defe-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Audio rechecking is deferred. A text-only cleanup model cannot recover a negation that Whisper never transcribed, and repeating the same decode is not independent verification."
        }
      ],
      "children": []
    },
    "b-text-correction-before-adding-a-verifica-25": {
      "id": "b-text-correction-before-adding-a-verifica-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Before adding a verification mode, benchmark human-recorded positive/negative pairs and difficult short answers. Compare baseline recognition with alternate settings and audio crops; measure omissions, invented negations, answer recall, and p50/p95 latency. Ship a mode only if the measured benefit justifies the added delay and false corrections. No current setting guarantees every omitted word is caught."
        }
      ],
      "children": []
    }
  }
}
