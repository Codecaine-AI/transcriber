    "b-architecture-the-server-talks-to-help-4": {
      "id": "b-architecture-the-server-talks-to-help-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The server talks to helpers over bounded JSON-lines pipes. Models warm at startup and stay loaded, except local Whisper while Deepgram is usable. The client contains no model helpers. The client never starts or stops the server. Bun manages the JavaScript dependencies and compiles the server into a standalone executable. The native application and inference server have no Python runtime dependency. The Codecaine archive worker and Data viewer require Python 3.12 or later."
        }
      ],
      "children": []
    },
    "b-architecture-a-recording-5": {
      "id": "b-architecture-a-recording-5",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "A recording"
        }
      ],
      "children": []
    },
    "b-architecture-the-client-asks-the-serv-6": {
      "id": "b-architecture-the-client-asks-the-serv-6",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The client asks the server to create a generation with its device identity. The server freezes shared settings and accepts independent uploads from any connected client. Offline or unavailable speech recognition prevents capture. Other recordings in progress do not."
        }
      ],
      "children": [
        "arch-step1-overlap"
      ]
    },
    "arch-step1-overlap": {
      "id": "arch-step1-overlap",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The fork sends the create request while the microphone starts, not before it. The upload queue holds the audio captured before the server answers."
        }
      ],
      "children": []
    },
    "b-architecture-the-client-pins-its-micr-7": {
      "id": "b-architecture-the-client-pins-its-micr-7",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The client pins its microphone and uploads acknowledged, sequenced PCM chunks while recording. Inference audio is mono 16 kHz float32; optional original audio keeps the microphone rate/channels as float32."
        }
      ],
      "children": [
        "arch-step2-original",
        "arch-step2-channels",
        "arch-step2-default",
        "arch-step2-spill"
      ]
    },
    "arch-step2-original": {
      "id": "arch-step2-original",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The client always captures and saves the full multichannel original. The server's retention setting decides whether the client uploads it."
        }
      ],
      "children": []
    },
    "arch-step2-channels": {
      "id": "arch-step2-channels",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Transcribe from",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " on the "
        },
        {
          "insert": "Microphone",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " page picks the channels mixed into each device's inference audio. Its config key is "
        },
        {
          "insert": "microphones.inferenceChannels",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", keyed by device UID."
        }
      ],
      "children": []
    },
    "arch-step2-default": {
      "id": "arch-step2-default",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Without a saved choice, a Scarlett Solo 4th Gen uses channel 2, its microphone input. Other devices keep upstream's mix of every channel."
        }
      ],
      "children": []
    },
    "arch-step2-spill": {
      "id": "arch-step2-spill",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A slow server never ends a take. The client holds about 8 MiB of audio in memory, then spills to an unlinked temporary file until the upload catches up."
        }
      ],
      "children": []
    },
    "b-architecture-release-stops-capture-d-8": {
      "id": "b-architecture-release-stops-capture-d-8",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Release stops capture, drains uploads, and sends final frame counts. The microphone is available for the next take while earlier uploads finish. The server checks the complete intervals and seals WAV files. Recordings must be 0.25–180 seconds."
        }
      ],
      "children": [
        "arch-step3-staging",
        "arch-step3-rename"
      ]
    },
    "arch-step3-staging": {
      "id": "arch-step3-staging",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The fork's server writes each chunk straight into a staging WAV named "
        },
        {
          "insert": "<kind>.wav.upload",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It updates the WAV header before it acknowledges the chunk."
        }
      ],
      "children": []
    },
    "arch-step3-rename": {
      "id": "arch-step3-rename",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Sealing renames the staging files instead of copying them, which saves about 0.7 s on a 22-second take. Deepgram's Finalize starts before the seal."
        }
      ],
      "children": []
    },
    "b-architecture-the-server-runs-whisper-9": {
      "id": "b-architecture-the-server-runs-whisper-9",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Sealed recordings enter a FIFO processing queue, and one job at a time runs speech recognition, mechanical cleanup, dictionary rules, and list formatting."
        }
      ],
      "children": [
        "arch-step4-speech",
        "arch-step4-qwen",
        "arch-step4-reject",
        "arch-step4-cancel"
      ]
    },
    "arch-step4-speech": {
      "id": "arch-step4-speech",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Speech Recognition, later on this page, describes how the server chooses Deepgram or local Whisper."
        }
      ],
      "children": []
    },
    "arch-step4-qwen": {
      "id": "arch-step4-qwen",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Optional Qwen output passes through dictionary rules and deterministic rewrite checks."
        }
      ],
      "children": []
    },
    "arch-step4-reject": {
      "id": "arch-step4-reject",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Rejection or proofreading failure keeps the pre-proofreading text."
        }
      ],
      "children": []
    },
    "arch-step4-cancel": {
      "id": "arch-step4-cancel",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Cancelling one upload or queued job does not interrupt another."
        }
      ],
      "children": []
    },
    "b-architecture-ndjson-events-carry-prog-10": {
      "id": "b-architecture-ndjson-events-carry-prog-10",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "NDJSON events carry progress and the saved final result for each generation. Each pending client take keeps its original server connection and destination. The client serializes delivery attempts, verifies focus/caret safety, and reports each outcome separately from inference completion."
        }
      ],
      "children": []
    },
    "b-architecture-interrupted-partial-uplo-11": {
      "id": "b-architecture-interrupted-partial-uplo-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Interrupted partial uploads expire. A complete upload can finish after the client disconnects. Pending takes recover interrupted event streams by checking their saved generation and reconnecting. Opening history never pastes an old result. There is no offline capture queue or automatic audio-upload retry."
        }
      ],
      "children": []
    },
    "arch-durable-lead": {
      "id": "arch-durable-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The fork keeps the audio of every take that does not finish."
        }
      ],
      "children": []
    },
    "arch-durable-client": {
      "id": "arch-durable-client",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The client records each take under "
        },
        {
          "insert": "Active Recordings",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in its settings directory. It deletes the take only after the server confirms the finished take, or after an explicit cancel."
        }
      ],
      "children": [
        "arch-durable-client-recover"
      ]
    },
    "arch-durable-client-recover": {
      "id": "arch-durable-client-recover",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A failure or a quit moves the take to "
        },
        {
          "insert": "Recovered Recordings/<timestamp>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with a "
        },
        {
          "insert": "recovery.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " note. The next launch also recovers a take that a crash left in "
        },
        {
          "insert": "Active Recordings",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "arch-durable-server": {
      "id": "arch-durable-server",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A server restart or a failed seal marks the record failed, and a cancel or an upload expiry marks it cancelled."
        }
      ],
      "children": [
        "arch-durable-server-audio"
      ]
    },
    "arch-durable-server-audio": {
      "id": "arch-durable-server-audio",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "In each case the server attaches the acknowledged audio to the record instead of deleting it. The archive worker imports these records with their audio."
        }
      ],
      "children": []
    },
    "arch-durable-text": {
      "id": "arch-durable-text",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The server saves the raw transcript before cleanup, so a cleanup failure keeps it."
        }
      ],
      "children": [
        "arch-durable-text-order"
      ]
    },
    "arch-durable-text-order": {
      "id": "arch-durable-text-order",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The server writes the transcript files in parallel and metadata last. A delivery receipt updates metadata only."
        }
      ],
      "children": []
    },
    "architecture-activation-modes": {
      "id": "architecture-activation-modes",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "Trigger",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " setting under "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " selects one of three ways for the dictation key to start and end a take."
        }
      ],
      "children": []
    },
    "architecture-mode-hold": {
      "id": "architecture-mode-hold",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Hold to talk",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " records while the key is held."
        }
      ],
      "children": []
    },
    "architecture-mode-double": {
      "id": "architecture-mode-double",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Double tap to toggle",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " starts recording on a double tap and ends it on a second double tap."
        }
      ],
      "children": []
    },
    "architecture-mode-single": {
      "id": "architecture-mode-single",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Press to start and stop",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " starts recording when the key goes down, and the next press stops it and delivers the text."
        }
      ],
      "children": [
        "architecture-mode-single-fork",
        "architecture-mode-single-chord",
        "architecture-mode-single-release",
        "architecture-mode-single-debounce"
      ]
    },
    "architecture-mode-single-fork": {
      "id": "architecture-mode-single-fork",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "This mode is a fork addition with the config token "
        },
        {
          "insert": "singleTap",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Upstream V07 has only the first two modes."
        }
      ],
      "children": []
    },
    "architecture-mode-single-chord": {
      "id": "architecture-mode-single-chord",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A chord while the starting press is still held cancels the take that press started. A chord is the key with another key, a modifier, or a click."
        }
      ],
      "children": []
    },
    "architecture-mode-single-release": {
      "id": "architecture-mode-single-release",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The key's release does nothing, and a stopping press always stops the take."
        }
      ],
      "children": []
    },
    "architecture-mode-single-debounce": {
      "id": "architecture-mode-single-debounce",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A press within 200 ms of the previous press is ignored. Escape cancels a latched take."
        }
      ],
      "children": []
    },
    "arch-speech-heading": {
      "id": "arch-speech-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Speech Recognition"
        }
      ],
      "children": []
    },
    "arch-speech-lead": {
      "id": "arch-speech-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Deepgram "
        },
        {
          "insert": "nova-3",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " recognizes speech first, and local Whisper "
        },
        {
          "insert": "large-v3-turbo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the fallback. Upstream V07 uses local Whisper only, so this routing is a fork difference. Deepgram replaces only the speech step. Dictionary rules, list formatting, and Qwen proofreading run unchanged on its text."
        }
      ],
      "children": []
    },
    "arch-speech-stream": {
      "id": "arch-speech-stream",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The server streams inference audio to Deepgram's WebSocket while the user speaks."
        }
      ],
      "children": [
        "arch-speech-stream-detail"
      ]
    },
    "arch-speech-stream-detail": {
      "id": "arch-speech-stream-detail",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The transcript is ready right after release."
        }
      ],
      "children": []
    },
    "arch-speech-retry": {
      "id": "arch-speech-retry",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A Deepgram error starts two retries through Deepgram's prerecorded API with the saved clip, then local Whisper."
        }
      ],
      "children": [
        "arch-speech-retry-ceiling",
        "arch-speech-retry-skip"
      ]
    },
    "arch-speech-retry-ceiling": {
      "id": "arch-speech-retry-ceiling",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Each attempt has a 15-second ceiling. A slow response causes a fallback only when it reaches that ceiling."
        }
      ],
      "children": []
    },
    "arch-speech-retry-skip": {
      "id": "arch-speech-retry-skip",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An offline network, an authentication failure, or a missing key skips the retries and goes straight to local Whisper."
        }
      ],
      "children": []
    },
    "arch-speech-prewarm": {
      "id": "arch-speech-prewarm",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "If the live socket fails to open, the server starts loading local Whisper at once."
        }
      ],
      "children": [
        "arch-speech-prewarm-detail"
      ]
    },
    "arch-speech-prewarm-detail": {
      "id": "arch-speech-prewarm-detail",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Whisper is then warm when the user stops talking."
        }
      ],
      "children": []
    },
    "arch-speech-key": {
      "id": "arch-speech-key",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The server reads "
        },
        {
          "insert": "DEEPGRAM_API_KEY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from the shared Codecaine env file "
        },
        {
          "insert": "~/.config/codecaine/env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": [
        "arch-speech-key-env",
        "arch-speech-key-cache"
      ]
    },
    "arch-speech-key-env": {
      "id": "arch-speech-key-env",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A variable already set in the server's process environment wins over the file."
        }
      ],
      "children": []
    },
    "arch-speech-key-cache": {
      "id": "arch-speech-key-cache",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The server keeps the key in memory until the file's size or modification time changes, so a rotated key applies to the next take."
        }
      ],
      "children": []
    },
    "arch-speech-lazy": {
      "id": "arch-speech-lazy",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Local Whisper loads on demand while Deepgram is usable."
        }
      ],
      "children": [
        "arch-speech-lazy-unload",
        "arch-speech-lazy-eager"
      ]
    },
    "arch-speech-lazy-unload": {
      "id": "arch-speech-lazy-unload",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Whisper loads on the first fallback and unloads after 1 hour without local use, which frees about 1.6 to 2 GB of memory."
        }
      ],
      "children": []
    },
    "arch-speech-lazy-eager": {
      "id": "arch-speech-lazy-eager",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "When Deepgram is off or no key exists, Whisper warms at startup and stays loaded."
        }
      ],
      "children": []
    },
    "arch-speech-provenance": {
      "id": "arch-speech-provenance",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Turning off "
        },
        {
          "insert": "Transcribe with Deepgram",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " under "
        },
        {
          "insert": "Server preferences",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " limits recognition to local Whisper, and audio stays on the Mac. Each generation's "
        },
        {
          "insert": "speech",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " provenance records the provider and an optional "
        },
        {
          "insert": "fallbackReason",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The "
        },
        {
          "insert": "HTTP API",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-http-api"
            }
          }
        },
        {
          "insert": " page defines both fields."
        }
      ],
      "children": []
    },
    "b-architecture-text-delivery-12": {
      "id": "b-architecture-text-delivery-12",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Text delivery"
        }
      ],
      "children": []
    },
    "b-architecture-only-the-new-insertiont-13": {
      "id": "b-architecture-only-the-new-insertiont-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Only the new "
        },
        {
          "insert": "insertionText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " can be inserted; "
        },
        {
          "insert": "previewText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " may include earlier list items. Continuation requires a previous generation from the same device and a confirmed client-side cursor anchor. The server checks age and delivery state before reusing context. Invalid context falls back to a standalone take."
        }
      ],
      "children": []
    },
    "b-architecture-the-mac-rechecks-destina-14": {
      "id": "b-architecture-the-mac-rechecks-destina-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Mac rechecks destination, selection, protected fields, modifiers, and clipboard state before delivery. Unsafe destinations use clipboard or preview fallback. Only confirmed insertion advances cursor-based continuation. Editor text and Accessibility handles stay on the Mac."
        }
      ],
      "children": []
    },
    "b-architecture-microphone-capture-uses-15": {
      "id": "b-architecture-microphone-capture-uses-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Microphone capture uses input-only Core Audio without changing system routing or playback volume. Route changes apply to the next take. Release, cancellation, sleep/lock, or device loss ends capture."
        }
      ],
      "children": []
    },
    "arch-ready-lead": {
      "id": "arch-ready-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keep microphone ready",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " on the "
        },
        {
          "insert": "Microphone",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " page keeps the input device running while the app is open. It is on by default. A take then starts in about 20 to 50 ms instead of about 600 ms on a Scarlett Solo."
        }
      ],
      "children": []
    },
    "arch-ready-discard": {
      "id": "arch-ready-discard",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The client discards the audio between takes, and the macOS microphone indicator stays on."
        }
      ],
      "children": []
    },
    "arch-ready-bluetooth": {
      "id": "arch-ready-bluetooth",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Bluetooth inputs never stay running and open for each take."
        }
      ],
      "children": []
    },
    "arch-ready-rebuild": {
      "id": "arch-ready-rebuild",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The client rebuilds the running input after a device or format change, sleep and wake, or an error."
        }
      ],
      "children": [
        "arch-ready-fallback"
      ]
    },
    "arch-ready-fallback": {
      "id": "arch-ready-fallback",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Until the rebuild succeeds, each take opens the device itself, as upstream does."
        }
      ],
      "children": []
    },
    "architecture-output-muting": {
      "id": "architecture-output-muting",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "With "
        },
        {
          "insert": "Mute system audio while recording",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " enabled under "
        },
        {
          "insert": "This Mac",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", the client mutes the default output device when a take starts and restores it when capture ends. The client restores only the mute controls it changed, so output that was already muted stays muted. A client crash during a take can leave output muted."
        }
      ],
      "children": []
    },
    "b-architecture-settings-16": {
      "id": "b-architecture-settings-16",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Settings"
        }
      ],
      "children": []
    },
    "b-architecture-scope-where-to-edit-17-table": {
      "id": "b-architecture-scope-where-to-edit-17-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Scope",
          "Where to edit",
          "What it owns"
        ],
        "rows": [
          [
            "This Mac",
            [
              {
                "insert": "This Mac",
                "attributes": {
                  "bold": true
                }
              },
              {
                "insert": " and "
              },
              {
                "insert": "Microphone",
                "attributes": {
                  "bold": true
                }
              }
            ],
            "Endpoint/token, device name, shortcut and trigger mode, launch at login, output muting while recording, microphone priority/selection, keep microphone ready, transcription channels per device."
          ],
          [
            "Shared server",
            [
              {
                "insert": "Server preferences",
                "attributes": {
                  "bold": true
                }
              }
            ],
            "Deepgram speech toggle, cleanup prompt, vocabulary, dictionary, proofreading toggle, original-audio retention."
          ],
          [
            "Server process",
            "Command arguments or environment",
            [
              {
                "insert": "Bind address, port, data directory, token file, helper/model paths. See "
              },
              {
                "insert": "server setup",
                "attributes": {
                  "link": "../Server/README.md"
                }
              },
              {
                "insert": "."
              }
            ]
          ]
        ]
      },
      "children": []
    },
    "architecture-settings-language": {
      "id": "architecture-settings-language",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Transcriber dictates English only, so its "
        },
        {
          "insert": "Server preferences",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " page has no "
        },
        {
          "insert": "Language",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " picker. The "
        },
        {
          "insert": "language",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " preference stays in the API for upstream compatibility, and its default is "
        },
        {
          "insert": "en",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-architecture-shared-saves-use-revisio-18": {
      "id": "b-architecture-shared-saves-use-revisio-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Shared saves use revisions to reject stale concurrent edits. Settings are snapshotted when the server accepts a take. Changes affect future recordings. Update shared settings through the UI/API rather than editing files while the server runs."
        }
      ],
      "children": []
    },
    "b-architecture-the-regular-app-uses-19": {
      "id": "b-architecture-the-regular-app-uses-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The client reads its name and bundle identifier from its own bundle in "
        },
        {
          "insert": "Sources/V07Core/V07Build.swift",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "Sources/V07Core/V07Build.swift"
            }
          }
        },
        {
          "insert": ". The settings directory is named after the app, and the Keychain service is the bundle identifier plus "
        },
        {
          "insert": ".server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Transcriber uses "
        },
        {
          "insert": "~/Library/Application Support/Transcriber",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "ai.codecaine.transcriber.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and Transcriber Dev uses "
        },
        {
          "insert": "~/Library/Application Support/Transcriber Dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "ai.codecaine.transcriber.dev.server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". An upstream V07 build uses "
        },
        {
          "insert": "~/Library/Application Support/V07",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and V07 Dev uses "
        },
        {
          "insert": "~/Library/Application Support/V07 Dev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "architecture-client-files": {
      "id": "architecture-client-files",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "V07_CLIENT_DATA_DIR",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overrides the settings directory, and the dev runner selects "
        },
        {
          "insert": ".local/client",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stores shortcut/microphone settings. "
        },
        {
          "insert": "client.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stores endpoint/device identity. Tokens live in the Keychain, scoped to the endpoint and client directory. "
        },
        {
          "insert": "V07_SERVER_URL",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overrides the saved endpoint for a run. Valid manual "
        },
        {
          "insert": "config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " edits are reloaded. Invalid files leave the last good configuration active."
        }
      ],
      "children": []
    },
    "b-architecture-storage-20": {
      "id": "b-architecture-storage-20",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Storage"
        }
      ],
      "children": []
    },
    "b-architecture-the-server-s-data-dir-21": {
      "id": "b-architecture-the-server-s-data-dir-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The server's "
        },
        {
          "insert": "--data-dir",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (normally "
        },
        {
          "insert": ".local/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in development) contains:"
        }
      ],
      "children": []
    },
    "b-architecture-text-22": {
      "id": "b-architecture-text-22",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "preferences.json\ngenerations/<UUID>/\n  metadata.json\n  transcript.txt\n  raw.txt\n  clean.txt\n  inference.wav\n  original.wav"
        }
      ],
      "children": []
    },
    "b-architecture-metadata-includes-device-23": {
      "id": "b-architecture-metadata-includes-device-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Metadata includes device identity, settings snapshot, raw/final text, insertion/preview text, model and processing details, and any delivery receipt. "
        },
        {
          "insert": "transcript.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " contains the current take's final text. Inference audio is always retained for completed takes; original audio is optional and defaults on. The retention toggle does not remove existing files, and there is no automatic history expiry."
        }
      ],
      "children": []
    },
    "b-architecture-all-clients-read-shared-24": {
      "id": "b-architecture-all-clients-read-shared-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "All clients read shared, paginated history. Deleting an inactive generation deletes its server artifacts. Failed and cancelled takes keep their metadata and acknowledged audio. Partial upload files are internal and cannot be downloaded."
        }
      ],
      "children": []
    },
    "b-architecture-only-one-server-may-own-25": {
      "id": "b-architecture-only-one-server-may-own-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Only one server may own a data directory. Back up preferences and generation directories together. The server does not add filesystem encryption; protect this directory as you would the recordings it contains. Authentication and remote transport are described in the "
        },
        {
          "insert": "server guide",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/20-server-setup"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-architecture-see-the-http-contract-26": {
      "id": "b-architecture-see-the-http-contract-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "See the "
        },
        {
          "insert": "HTTP contract",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-http-api"
            }
          }
        },
        {
          "insert": " for request details and "
        },
        {
          "insert": "text correction",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-text-correction"
            }
          }
        },
        {
          "insert": " for behavior and limitations."
        }
      ],
      "children": []
    },
    "b-architecture-the-separate-transcript-27": {
      "id": "b-architecture-the-separate-transcript-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The separate "
        },
        {
          "insert": "Transcript Archive",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-transcript-archive"
            }
          }
        },
        {
          "insert": " preserves records after deletion from operational history."
        }
      ],
      "children": []
    }
  }
}
