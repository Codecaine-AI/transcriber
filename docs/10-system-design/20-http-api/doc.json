    "b-client-server-contract-api-version-1-default-p-1": {
      "id": "b-client-server-contract-api-version-1-default-p-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "API version 1, default port "
        },
        {
          "insert": "8391",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "Server/api/openapi.yaml",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "Server/api/openapi.yaml"
            }
          }
        },
        {
          "insert": " defines the transport contract and generates the TypeScript and Swift types. "
        },
        {
          "insert": "Sources/V07API/API.swift",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "Sources/V07API/API.swift"
            }
          }
        },
        {
          "insert": " holds the Swift client-facing facade and defaults. JSON uses whole-second ISO-8601 UTC dates. macOS and Linux expose the same API. See "
        },
        {
          "insert": "server setup",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-guides/20-server-setup"
            }
          }
        },
        {
          "insert": " for authentication and endpoint configuration."
        }
      ],
      "children": []
    },
    "b-client-server-contract-routes-2": {
      "id": "b-client-server-contract-routes-2",
      "type": "heading",
