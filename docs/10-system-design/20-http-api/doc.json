    "b-client-server-contract-route-request-resp-3-table": {
      "id": "b-client-server-contract-route-request-resp-3-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Route",
          "Request / response"
        ],
        "rows": [
          [
            [
              {
                "insert": "GET /v1/health",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "ServerHealth",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "; server reachability differs from ready inference. Lightweight health contains no user data."
              }
            ]
          ],
          [
            [
              {
                "insert": "GET /v1/preferences",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "PreferencesSnapshot",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            [
              {
                "insert": "PUT /v1/preferences",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "PreferencesSnapshot",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " with expected revision; validates and returns incremented snapshot, 409 if stale."
              }
            ]
          ],
          [
            [
              {
                "insert": "POST /v1/generations",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "CreateGenerationRequest",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " → "
              },
              {
                "insert": "GenerationRecord",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " with server UUID and frozen settings. Idempotent requestID scoped to device. Admission occurs before microphone capture."
              }
            ]
          ],
          [
            [
              {
                "insert": "POST /v1/generations/:id/audio/:kind?sequence=0&sampleRate=16000&channels=1",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Binary little-endian interleaved float32 PCM, ≤1 MiB per request. "
              },
              {
                "insert": "kind",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " is "
              },
              {
                "insert": "inference",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " or "
              },
              {
                "insert": "original",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ". Every request has sequence/format; format fixed per stream. Exact repeated chunk idempotent; gaps/conflicting repeats reject. → "
              },
              {
                "insert": "AudioChunkReceipt",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "."
              }
            ]
          ],
          [
            [
              {
                "insert": "POST /v1/generations/:id/finish",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "FinishGenerationRequest",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " with exact frame counts. All chunks must be acknowledged first. Optional previous continuation generation ID. Seals WAV artifacts atomically and submits processing. → "
              },
              {
                "insert": "GenerationRecord",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "."
              }
            ]
          ],
          [
            [
              {
                "insert": "GET /v1/generations/:id/events",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "application/x-ndjson",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", each line a full "
              },
              {
                "insert": "GenerationRecord",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "; emit current state, updates, and two-second heartbeats until terminal. Disconnecting after complete upload does not cancel inference."
              }
            ]
          ],
          [
            [
              {
                "insert": "GET /v1/generations/:id",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "GenerationRecord",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            [
              {
                "insert": "GET /v1/generations?limit=50&before=CURSOR",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "GenerationPage",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", descending creation order, bounded limit/cursor."
              }
            ]
          ],
          [
            [
              {
                "insert": "POST /v1/generations/:id/cancel",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Explicit cancellation, terminal idempotency, → "
              },
              {
                "insert": "GenerationRecord",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "."
              }
            ]
          ],
          [
            [
              {
                "insert": "POST /v1/generations/:id/delivery",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "DeliveryReceipt",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "; store actual client outcome separately from inference completion. → "
              },
              {
                "insert": "GenerationRecord",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "."
              }
            ]
          ],
          [
            [
              {
                "insert": "PUT /v1/generations/:id/app-context",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "AppContext",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " → "
              },
              {
                "insert": "GenerationRecord",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", with a body of at most 256 KiB. App Context gives the takes that accept it."
              }
            ]
          ],
          [
            [
              {
                "insert": "GET /v1/generations/:id/artifacts/:filename",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Allowlisted original.wav, inference.wav, transcript.txt, raw.txt, clean.txt, metadata.json, and declared imported artifacts."
          ],
          [
            [
              {
                "insert": "DELETE /v1/generations/:id",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Explicit history removal; active generation cannot be deleted. 204."
          ]
        ]
      },
      "children": []
    },
    "b-client-server-contract-errors-are-apierrorresp-4": {
      "id": "b-client-server-contract-errors-are-apierrorresp-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Errors are "
        },
        {
          "insert": "APIErrorResponse",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; relevant codes 400 invalid input, 401 auth, 404 missing, 409 stale/conflict, 413 limits, 503 unavailable. Bearer authorization on data routes if token configured; nonloopback server binds require a token. Remote connections use HTTPS; localhost and explicit Tailscale endpoints can use HTTP. No credentials in URLs or diagnostics."
        }
      ],
      "children": []
    },
    "b-client-server-contract-generation-semantics-5": {
      "id": "b-client-server-contract-generation-semantics-5",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Generation semantics"
        }
      ],
      "children": []
    },
    "b-client-server-contract-server-owns-settings-dic-6": {
      "id": "b-client-server-contract-server-owns-settings-dic-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Server owns settings/dictionary, inference, formatting, proofreading, rewrite guards, composition, artifacts and history. Client owns only ephemeral capture/AX anchors and device preferences."
        }
      ],
      "children": []
    },
    "http-api-recording-queue": {
      "id": "http-api-recording-queue",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Receiving uploads are independent. Finishing a complete upload seals its audio and queues processing in finish order, and inference runs serially. Health readiness indicates admission availability, regardless of other receiving, queued, or processing recordings. Cancellation affects only the named generation."
        }
      ],
      "children": []
    },
    "b-client-server-contract-inference-audio-is-mono-7": {
      "id": "b-client-server-contract-inference-audio-is-mono-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Inference audio is mono 16k float32, and both audio intervals must match."
        }
      ],
      "children": [
        "http-api-original-audio-format",
        "http-api-take-duration"
      ]
    },
    "http-api-original-audio-format": {
      "id": "http-api-original-audio-format",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Original audio is the input microphone format normalized to interleaved float32. The server retains it only if the accepted settings snapshot says keepOriginalAudio."
        }
      ],
      "children": []
    },
    "http-api-take-duration": {
      "id": "http-api-take-duration",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A take lasts at least 0.25 s and at most 600 s (10 minutes). Only sealed complete uploads run inference."
        }
      ],
      "children": []
    },
    "b-client-server-contract-sequence-counts-are-inde-8": {
      "id": "b-client-server-contract-sequence-counts-are-inde-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Sequence counts are independent for each audio kind. Server handles incomplete upload expiry, bounded disk and request buffers, validates byte/frame counts and formats, and never accepts caller filesystem paths."
        }
      ],
      "children": []
    },
    "b-client-server-contract-native-helpers-remain-se-9": {
      "id": "b-client-server-contract-native-helpers-remain-se-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Native helpers remain separate persistent processes (independent ggml versions). Whisper everywhere; macOS Qwen MLX; Linux Qwen llama.cpp/GGUF. Server applies current deterministic domain logic; client inserts returned insertionText once with existing destination/caret checks."
        }
      ],
      "children": []
    },
    "b-client-server-contract-continuationid-reference-10": {
      "id": "b-client-server-contract-continuationid-reference-10",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "ContinuationID references a completed prior generation from the same device and is sent only if the client has an exact confirmed caret anchor. Server checks age and valid delivery or test/control-only state before reusing its stored continuation. Deleted, stale, or invalid context falls back to standalone composition without discarding the new recording. No editor text/AX handles go over the wire."
        }
      ],
      "children": []
    },
    "b-client-server-contract-a-lost-connection-during-11": {
      "id": "b-client-server-contract-a-lost-connection-during-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A lost connection during capture/upload stops capture and clears client temporary buffers. The lost connection leaves the server to cancel/expire the partial generation. No offline queue or retry UI. Once upload is complete, server may finish independently. Later viewing history does not paste."
        }
      ],
      "children": []
    },
    "b-client-server-contract-api-result-bytes-and-met-12": {
      "id": "b-client-server-contract-api-result-bytes-and-met-12",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "API result bytes and metadata are server-owned. All clients read the same history, tagged with the original device ID/name."
        }
      ],
      "children": []
    },
    "b-client-server-contract-shared-original-audio-se-13": {
      "id": "b-client-server-contract-shared-original-audio-se-13",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Shared original-audio setting defaults on. Inference audio is always retained for completed generations. Changes affect future takes. Local server storage is a configurable persistent data directory. Hosted deployments mount durable storage."
        }
      ],
      "children": []
    },
    "http-api-speech-provenance": {
      "id": "http-api-speech-provenance",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The fork recognizes speech with Deepgram first and local Whisper as the fallback, as "
        },
        {
          "insert": "Architecture",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-architecture"
            }
          }
        },
        {
          "insert": " describes. A generation's "
        },
        {
          "insert": "speech",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "ModelProvenance",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records "
        },
        {
          "insert": "nova-3",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with backend "
        },
        {
          "insert": "Deepgram",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or the Whisper model. Its optional "
        },
        {
          "insert": "fallbackReason",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " string says why recognition fell back to local Whisper. "
        },
        {
          "insert": "ServerHealth.speech",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " reports Deepgram with a message such as "
        },
        {
          "insert": "Deepgram primary; local Whisper loads on demand.",
          "attributes": {
            "code": true
          }
        }
      ],
      "children": []
    },
    "http-api-app-context": {
      "id": "http-api-app-context",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "App Context"
        }
      ],
      "children": []
    },
    "http-api-app-context-lead": {
      "id": "http-api-app-context-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "GenerationRecord.appContext",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records the apps around one take. The server keeps it as data for later use, and transcription does not read it. A focus snapshot is one record of the focused app, window, and web page at one moment."
        }
      ],
      "children": []
    },
    "http-api-app-context-shape": {
      "id": "http-api-app-context-shape",
      "type": "state-shape",
      "props": {
        "example": "{\"start\":{\"capturedAt\":\"2026-11-13T17:02:11Z\",\"application\":{\"bundleID\":\"com.apple.Safari\",\"name\":\"Safari\"},\"windowTitle\":\"Pull requests\",\"url\":\"https://github.com/pulls\",\"host\":\"github.com\"},\"delivery\":{\"capturedAt\":\"2026-11-13T17:02:40Z\",\"application\":{\"bundleID\":\"com.apple.Safari\",\"name\":\"Safari\"},\"windowTitle\":\"Pull requests\",\"url\":\"https://github.com/pulls\",\"host\":\"github.com\"},\"openApplications\":[{\"bundleID\":\"com.apple.Safari\",\"name\":\"Safari\"},{\"bundleID\":\"com.apple.Terminal\",\"name\":\"Terminal\"}]}",
        "fields": [
          {
            "name": "start",
            "type": "FocusSnapshot",
            "required": false,
            "description": "Focus when the take started. Only live takes set it.",
            "fields": [
              {
                "name": "capturedAt",
                "type": "string (date-time)",
                "required": false,
                "description": "Whole-second ISO-8601 UTC time of the snapshot."
              },
              {
                "name": "application",
                "type": "ApplicationIdentity",
                "description": "The focused app. Holds at least one of `bundleID` and `name`.",
                "fields": [
                  {
                    "name": "bundleID",
                    "type": "string",
                    "required": false,
                    "description": "1 to 255 characters, such as `com.apple.Safari`. The client drops a longer one."
                  },
                  {
                    "name": "name",
                    "type": "string",
                    "required": false,
                    "description": "Display name that macOS reports. Wispr Flow imports leave it out."
                  }
                ]
              },
              {
                "name": "windowTitle",
                "type": "string",
                "required": false,
                "description": "Title of the focused window, trimmed, at most 1,024 characters."
              },
              {
                "name": "url",
                "type": "string",
                "required": false,
                "description": "Scheme, host, port, and path of the focused `http` or `https` page, at most 2,048 characters."
              },
              {
                "name": "host",
                "type": "string",
                "required": false,
                "description": "Host of the focused web page. Live takes set it with `url`, and Wispr Flow imports set it alone."
              }
            ]
          },
          {
            "name": "delivery",
            "type": "FocusSnapshot",
            "required": false,
            "description": "Focus when the client delivered the result, with the fields of `start`. Wispr Flow imports put the app that got the text here."
          },
          {
            "name": "openApplications",
            "type": "ApplicationIdentity[]",
            "required": false,
            "description": "Regular apps other than Transcriber when the take started, at most 256. Apps with on-screen windows come first, front to back, then the rest by name."
          }
        ],
        "name": "AppContext",
        "source": {
          "path": "Server/api/openapi.yaml",
          "symbol": "AppContext"
        }
      },
      "children": []
    },
    "http-api-app-context-start": {
      "id": "http-api-app-context-start",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The client records "
        },
        {
          "insert": "start",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "openApplications",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when the take starts."
        }
      ],
      "children": [
        "http-api-app-context-no-ax"
      ]
    },
    "http-api-app-context-no-ax": {
      "id": "http-api-app-context-no-ax",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Without Accessibility permission, a snapshot holds only the frontmost app, with no window title or URL."
        }
      ],
      "children": []
    },
    "http-api-app-context-delivery": {
      "id": "http-api-app-context-delivery",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "After delivery, the client records "
        },
        {
          "insert": "delivery",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and sends the whole context with "
