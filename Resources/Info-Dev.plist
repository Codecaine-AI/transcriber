<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>Transcriber</string>
	<key>CFBundleIdentifier</key>
	<string>ai.codecaine.transcriber.dev</string>
	<key>CFBundleName</key>
	<string>Transcriber Dev</string>
	<key>CFBundleDisplayName</key>
	<string>Transcriber Dev</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.14.1</string>
	<key>CFBundleVersion</key>
	<string>28</string>
	<key>CFBundleIconFile</key>
	<string>Transcriber</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Transcriber Dev records your microphone only while you dictate and sends audio to your configured Transcriber server for transcription and shared history.</string>
	<key>NSInputMonitoringUsageDescription</key>
	<string>Transcriber Dev listens for your chosen hold-to-dictate key. It does not store your keystrokes.</string>
	<!-- HTTP is validated in ServerEndpoint and limited to loopback/Tailscale IPs. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Transcriber Dev connects to your Transcriber server to process dictation and display shared history.</string>
	<key>TranscriberDevelopmentBuild</key>
	<true/>
</dict>
</plist>
